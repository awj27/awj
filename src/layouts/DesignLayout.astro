---
// Review-only shell for the redesign. Not indexed, not linked from the live site.
import { ClientRouter } from 'astro:transitions';
import '../styles/notebook.css';

interface Props { title: string; description?: string; draft?: boolean; snap?: boolean; }
const {
  title,
  description = 'Design direction for the andywhyte.com rebuild. Review material, not for publication.',
  draft = false,
  snap = false,
} = Astro.props;

const fonts = 'https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const links: [string, string][] = [
  ['/design/', 'Direction'],
  ['/design/home/', 'Home'],
  ['/design/maxim/', 'Maxim'],
  ['/design/hub/', 'Hub'],
];
---
<!doctype html>
<html lang="en-GB" data-type="b" data-snap={snap ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <link rel="icon" href="/notebook/mark/awj-mark-blue-320.png" type="image/png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    {draft && <div class="nb-draft">Draft copy · layout review</div>}
    <slot />

    <aside class="dd-bar" aria-label="Review navigation">
      <nav class="dd-bar__links">
        {links.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </aside>

    <style>
      .dd-bar {
        position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 60;
        display: flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: 999px;
        background: rgba(26,33,64,.92); color: #fff; box-shadow: 0 10px 30px rgba(20,28,60,.25);
        backdrop-filter: blur(8px); font-size: 13px; font-family: var(--font-b);
      }
      .dd-bar__links { display: flex; gap: 2px; }
      .dd-bar__links a { color: #fff; text-decoration: none; padding: 6px 10px; border-radius: 999px; opacity: .75; }
      .dd-bar__links a:hover { opacity: 1; background: rgba(255,255,255,.1); }
      .dd-bar__links a[aria-current] { opacity: 1; background: var(--nb-cover); }
      @media (max-width: 640px) { .dd-bar { bottom: 10px; font-size: 12px; } .dd-bar__links a { padding: 6px 8px; } }
    </style>
  </body>
</html>
