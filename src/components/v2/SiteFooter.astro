---
import SocialIcons from '../SocialIcons.astro';
---
<footer class="nb-footer" id="subscribe">
  <div class="nb-shell">
    <div class="nb-footer__top">
      <div class="nb-footer__brand">
        <img class="nb-footer__mark" src="/notebook/mark/awj-mark-white.png" alt="AWJ" width="1236" height="954" />
        <p class="nb-footer__tag">Sales, founding and being human. Written in a blue notebook, one principle at a time.</p>
        <p class="nb-footer__champ">May your Champions be Strong 💪</p>
      </div>
      <form class="nb-sub" action="#" method="post">
        <label class="nb-sub__label" for="sub-email">The journal, in your inbox</label>
        <p class="nb-sub__hint">New Maxims and essays, published on Substack. No schedule promised, no spam.</p>
        <div class="nb-sub__row">
          <input id="sub-email" type="email" placeholder="you@company.com" autocomplete="email" />
          <button class="btn btn--yellow" type="button">Subscribe</button>
        </div>
      </form>
    </div>

    <div class="nb-footer__cols">
      <div>
        <h4>Journal</h4>
        <a href="/design/home/#library">All Maxims</a><a href="#">Sales</a><a href="#">Founder</a><a href="#">Human</a>
      </div>
      <div>
        <h4>Topics</h4>
        <a href="/design/hub/">MEDDPICC and MEDDICC</a><a href="#">Sales leadership</a><a href="#">Keynote speaking</a><a href="#">Imposter syndrome</a>
      </div>
      <div>
        <h4>Andy</h4>
        <a href="#">About</a><a href="#">Speaking</a><a href="#">The book</a><a href="#">Media</a><a href="#">Contact</a>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <SocialIcons tone="light" size={20} />
      </div>
    </div>

    <div class="nb-footer__base">
      <span>© 2026 Andy Whyte</span>
      <a href="#">Privacy and cookies</a>
      <span>Founder and CEO, MEDDICC</span>
    </div>
  </div>
</footer>

<style>
  .nb-footer { background: var(--nb-cover); color: #fff; padding: clamp(56px, 8vw, 96px) 0 32px; margin-top: clamp(40px, 6vw, 80px); }
  .nb-footer a { color: #fff; }
  .nb-footer__top { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: start; padding-bottom: clamp(40px, 5vw, 64px); border-bottom: 1px solid rgba(255,255,255,.18); }
  .nb-footer__mark { width: 120px; height: auto; margin-bottom: 20px; }
  .nb-footer__tag { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.4; max-width: 30ch; letter-spacing: -0.01em; }
  .nb-footer__champ { margin-top: 14px; font-size: 14px; opacity: .8; }
  .nb-sub__label { display: block; font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  .nb-sub__hint { margin: 6px 0 16px; opacity: .82; font-size: 15px; }
  .nb-sub__row { display: flex; gap: 10px; }
  .nb-sub__row input { flex: 1; min-width: 0; height: 48px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.12); color: #fff; font: inherit; }
  .nb-sub__row input::placeholder { color: rgba(255,255,255,.6); }
  .nb-sub__row input:focus { outline: 2px solid var(--nb-yellow); outline-offset: 2px; }
  .nb-footer__cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding: clamp(32px, 4vw, 48px) 0; }
  .nb-footer__cols h4 { color: rgba(255,255,255,.7); margin-bottom: 14px; }
  .nb-footer__cols div { display: flex; flex-direction: column; gap: 8px; }
  .nb-footer__cols a { text-decoration: none; opacity: .92; }
  .nb-footer__cols a:hover { text-decoration: underline; }
  .nb-footer__base { display: flex; flex-wrap: wrap; gap: 16px 28px; justify-content: space-between; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.18); font-size: 13px; opacity: .8; }
  @media (max-width: 860px) {
    .nb-footer__top { grid-template-columns: 1fr; }
    .nb-footer__cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) { .nb-sub__row { flex-direction: column; } }
</style>
