---
// New-brand header: the handwritten AWJ mark, the name set in type, a quiet nav.
const nav: [string, string][] = [
  ['Maxims', '/design/home/#library'],
  ['MEDDPICC', '/design/hub/'],
  ['Speaking', '#'],
  ['Book', '#'],
  ['About', '#'],
];
---
<header class="nb-header" transition:name="nb-header">
  <div class="nb-shell nb-header__in">
    <a class="nb-brand" href="/design/home/" aria-label="Andy Whyte Journal, home">
      <img class="nb-brand__mark" src="/notebook/mark/awj-mark-ink-320.png" alt="" width="320" height="247" />
      <span class="nb-brand__name">Andy Whyte</span>
    </a>
    <nav class="nb-nav" aria-label="Primary">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <div class="nb-header__actions">
      <a class="btn btn--blue nb-header__cta" href="#subscribe">Subscribe</a>
      <details class="nb-menu">
        <summary aria-label="Menu"><span></span><span></span></summary>
        <nav class="nb-menu__panel" aria-label="Mobile">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
          <a href="#subscribe">Subscribe on Substack</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nb-header { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.88); backdrop-filter: blur(10px); }
  .nb-header__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 72px; }
  .nb-brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--nb-text); }
  .nb-brand__mark { width: 46px; height: auto; }
  .nb-brand__name { font-weight: 600; letter-spacing: -0.01em; font-size: 17px; }
  .nb-nav { display: flex; gap: 2px; }
  .nb-nav a { text-decoration: none; color: var(--nb-text-2); font-weight: 500; font-size: 15px; padding: 8px 12px; border-radius: 999px; }
  .nb-nav a:hover { color: var(--nb-text); background: var(--nb-canvas-2); }
  .nb-header__actions { display: flex; align-items: center; gap: 10px; }
  .nb-menu { position: relative; display: none; }
  .nb-menu summary { list-style: none; width: 40px; height: 40px; display: grid; place-content: center; gap: 5px; border-radius: 999px; border: 1px solid var(--nb-line); cursor: pointer; background: #fff; }
  .nb-menu summary::-webkit-details-marker { display: none; }
  .nb-menu summary span { display: block; width: 16px; height: 2px; background: var(--nb-text); border-radius: 2px; }
  .nb-menu__panel { position: absolute; right: 0; top: 48px; min-width: 230px; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--nb-line); border-radius: var(--radius-ui); box-shadow: var(--shadow-page); padding: 8px; }
  .nb-menu__panel a { text-decoration: none; color: var(--nb-text); padding: 10px 12px; border-radius: 8px; font-weight: 500; }
  .nb-menu__panel a:hover { background: var(--nb-canvas-2); }
  @media (max-width: 860px) {
    .nb-nav { display: none; }
    .nb-menu { display: block; }
    .nb-header__in { height: 64px; }
    .nb-brand__mark { width: 40px; }
  }
  @media (max-width: 420px) { .nb-header__cta { display: none; } }
</style>
