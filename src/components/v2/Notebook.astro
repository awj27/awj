---
// The notebook: a top-bound pad in CSS 3D. Pages lift over the top edge like the real thing.
// Motion study for design direction 01. Scroll binding to the page comes in checkpoint two.
import type { NotebookPage } from '../../data/notebook-pages';
import { pad2 } from '../../data/notebook-pages';

interface Props { pages: NotebookPage[]; startClosed?: boolean; id?: string; }
const { pages, startClosed = true, id = 'notebook' } = Astro.props;
---
<div
  class="nb-stage"
  id={id}
  data-notebook
  data-start-closed={startClosed ? 'true' : 'false'}
  tabindex="0"
  aria-roledescription="notebook"
  aria-label="The AWJ notebook. Use the arrow keys to turn the pages."
>
  <div class="nb-scene">
    <div class="nb-pad">
      <div class="nb-pad__stack" aria-hidden="true"><i></i><i></i><i></i></div>

      <div class="nb-leaves">
        {pages.map((p, i) => (
          <article class="nb-leaf" data-index={i} data-number={pad2(p.number)} style={`--i:${i}`}>
            <div class="nb-leaf__body">
              <div class="nb-leaf__front">
                <img src={p.src} alt={p.alt} width="1600" height="1096" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                <span class="nb-leaf__shade" aria-hidden="true"></span>
              </div>
              <div class="nb-leaf__back" aria-hidden="true"></div>
            </div>
            <h3 class="sr-only">AWJ No. {pad2(p.number)}: {p.title}</h3>
          </article>
        ))}
      </div>

      <div class="nb-spine" aria-hidden="true"></div>

      <div class="nb-cover" aria-hidden="true">
        <div class="nb-cover__front"><img src="/notebook/cover-landscape.webp" alt="" width="1638" height="1200" draggable="false" /></div>
        <div class="nb-cover__back"></div>
      </div>

      <div class="nb-shadow" aria-hidden="true"></div>
    </div>
    <div class="nb-cursor" aria-hidden="true"><span>Open</span></div>
  </div>

  <div class="nb-controls">
    <button type="button" class="nb-ctl" data-prev aria-label="Previous page">&larr;</button>
    <p class="nb-counter"><span data-counter aria-live="polite">Closed</span></p>
    <button type="button" class="nb-ctl" data-next aria-label="Next page">&rarr;</button>
    <button type="button" class="nb-ctl nb-ctl--text" data-sound aria-pressed="false" title="A quiet paper flick on each turn">Sound off</button>
    <button type="button" class="nb-ctl nb-ctl--text" data-tilt hidden>Enable tilt</button>
  </div>
  <p class="nb-hint">Scroll, swipe, click or use the arrow keys to turn the pages.</p>
</div>

<style>
  .nb-stage { position: relative; display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 28px 0 8px; outline: none; -webkit-user-select: none; user-select: none; }
  .nb-stage:focus-visible .nb-scene { outline: 2px solid var(--nb-cover); outline-offset: 22px; border-radius: 8px; }

  .nb-scene { position: relative; perspective: 1800px; perspective-origin: 50% -10%; width: min(640px, 92vw); touch-action: pan-x; }
  .has-cursor .nb-scene { cursor: none; }

  .nb-pad { position: relative; aspect-ratio: 1.46; transform-style: preserve-3d; transition: transform .6s var(--ease-out); }
  .nb-pad.is-nudge { animation: nb-nudge .45s var(--ease-out); }

  .nb-pad__stack { position: absolute; inset: 0; border-radius: var(--radius-page); background: var(--nb-paper); box-shadow: var(--shadow-page); transform: translateZ(-3px); }
  .nb-pad__stack i { position: absolute; inset: 0; border-radius: inherit; background: var(--nb-paper); border-bottom: 1px solid var(--nb-paper-shade); }
  .nb-pad__stack i:nth-child(1) { transform: translate3d(0, 2px, -1px); }
  .nb-pad__stack i:nth-child(2) { transform: translate3d(0, 4px, -2px); }
  .nb-pad__stack i:nth-child(3) { transform: translate3d(0, 6px, -3px); box-shadow: 0 10px 24px rgba(20,28,60,.12); }

  .nb-leaves { position: absolute; inset: 0; transform-style: preserve-3d; }
  /* Only the page on top and the one beneath it are rendered; the rest wait their turn.
     Keeps depth sorting unambiguous and the paint cost flat however many pages the pad holds. */
  .nb-leaf {
    position: absolute; inset: 0; transform-origin: 50% 0%; transform-style: preserve-3d;
    transform: translateZ(calc(var(--i) * -2px)) rotateX(0deg);
    visibility: hidden;
    transition: transform var(--dur-flip) var(--ease-flip), visibility 0s linear var(--dur-flip);
  }
  .nb-leaf.is-current, .nb-leaf.is-next { visibility: visible; transition: transform var(--dur-flip) var(--ease-flip), visibility 0s; }
  /* positive rotateX about the top edge lifts the bottom of the page toward the viewer, then over the top */
  .nb-leaf.is-flipped { transform: translateZ(calc(var(--i) * -2px)) rotateX(176deg); }
  .nb-leaf__body { position: absolute; inset: 0; transform-origin: 50% 0%; transform-style: preserve-3d; }
  .nb-leaf.is-current .nb-leaf__body { animation: nb-curl 7s ease-in-out infinite; }
  .nb-leaf__front, .nb-leaf__back { position: absolute; inset: 0; border-radius: var(--radius-page); overflow: hidden; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
  .nb-leaf__front { background: var(--nb-paper); }
  .nb-leaf__front img { width: 100%; height: 100%; object-fit: cover; }
  .nb-leaf__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,28,60,0) 30%, rgba(20,28,60,.38)); opacity: 0; transition: opacity calc(var(--dur-flip) * .55) ease; pointer-events: none; }
  .nb-leaf.is-flipping .nb-leaf__shade { opacity: 1; }
  .nb-leaf__back { background: linear-gradient(180deg, #EBE7E1, var(--nb-paper) 45%); transform: rotateX(180deg); }

  .nb-spine {
    position: absolute; left: -1.2%; right: -1.2%; top: -2.4%; height: 4.2%; z-index: 2;
    background: linear-gradient(180deg, var(--nb-cover-lit), var(--nb-cover) 55%, var(--nb-cover-deep));
    border-radius: 5px 5px 2px 2px; box-shadow: 0 2px 4px rgba(20,28,60,.28); transform: translateZ(1px);
  }

  .nb-cover {
    position: absolute; inset: -2.4% -1.2% -1.8% -1.2%; transform-origin: 50% 0%; transform-style: preserve-3d;
    transform: translateZ(2px) rotateX(0deg);
    transition: transform calc(var(--dur-flip) * 1.3) var(--ease-flip), visibility 0s linear calc(var(--dur-flip) * 1.3);
  }
  .nb-cover.is-open { transform: translateZ(2px) rotateX(178deg); visibility: hidden; }
  .nb-cover__front, .nb-cover__back { position: absolute; inset: 0; border-radius: 7px; overflow: hidden; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
  .nb-cover__front { box-shadow: var(--shadow-cover); background: var(--nb-cover); }
  .nb-cover__front img { width: 100%; height: 100%; object-fit: cover; }
  .nb-cover__back { background: linear-gradient(180deg, #2B3A94, var(--nb-cover-deep)); transform: rotateX(180deg); }

  .nb-shadow { position: absolute; left: 3%; right: 3%; bottom: -9%; height: 16%; background: radial-gradient(50% 50% at 50% 50%, rgba(20,28,60,.30), transparent 72%); filter: blur(12px); transform: translateZ(-12px); pointer-events: none; }

  .nb-cursor {
    position: absolute; left: 0; top: 0; z-index: 5; width: 58px; height: 58px; margin: -29px 0 0 -29px;
    border-radius: 999px; background: var(--nb-cover); color: #fff; display: grid; place-items: center;
    font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    pointer-events: none; opacity: 0; transform: translate(-200px, -200px); transition: opacity .2s, width .2s, height .2s;
  }
  .nb-cursor.is-on { opacity: .94; }

  .nb-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .nb-ctl { height: 40px; min-width: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--nb-line); background: #fff; font: inherit; font-size: 14px; font-weight: 600; color: var(--nb-text); cursor: pointer; transition: border-color .2s, transform .2s var(--ease-out); }
  .nb-ctl:hover { border-color: var(--nb-text-3); transform: translateY(-1px); }
  .nb-ctl[aria-pressed="true"] { background: var(--nb-text); color: #fff; border-color: var(--nb-text); }
  .nb-counter { margin: 0; min-width: 120px; text-align: center; font-size: 13px; color: var(--nb-text-3); font-variant-numeric: tabular-nums; }
  .nb-hint { margin: 0; font-size: 13px; color: var(--nb-text-3); text-align: center; }

  @keyframes nb-curl { 0%, 100% { transform: rotateX(0deg); } 50% { transform: rotateX(3.5deg); } }
  @keyframes nb-nudge { 0%, 100% { translate: 0 0; } 40% { translate: 0 -8px; } }

  @media (prefers-reduced-motion: reduce) {
    .nb-leaf, .nb-cover, .nb-pad { transition-duration: .01s; }
    .nb-leaf.is-current .nb-leaf__body { animation: none; }
    .nb-pad.is-nudge { animation: none; }
  }
</style>

<script>
  type El = HTMLElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;

  document.querySelectorAll<El>('[data-notebook]').forEach((root) => {
    const scene = root.querySelector<El>('.nb-scene')!;
    const pad = root.querySelector<El>('.nb-pad')!;
    const cover = root.querySelector<El>('.nb-cover')!;
    const leaves = Array.from(root.querySelectorAll<El>('.nb-leaf'));
    const counter = root.querySelector<El>('[data-counter]')!;
    const cursor = root.querySelector<El>('.nb-cursor')!;
    const cursorLabel = cursor.querySelector('span')!;
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]')!;
    const tiltBtn = root.querySelector<HTMLButtonElement>('[data-tilt]')!;

    let open = root.dataset.startClosed !== 'true';
    let index = 0;          // leaves already turned
    let busy = false;
    let soundOn = false;
    let audio: AudioContext | undefined;

    if (open) cover.classList.add('is-open');

    const lock = (ms: number) => { busy = true; setTimeout(() => { busy = false; }, reduce ? 40 : ms); };
    const nudge = () => { pad.classList.add('is-nudge'); setTimeout(() => pad.classList.remove('is-nudge'), 460); };

    function update() {
      const cur = open ? index : -1;          // the page on top (breathes while it waits)
      const nxt = open ? index + 1 : 0;       // the page beneath (shows as the one above lifts)
      leaves.forEach((l, i) => {
        l.classList.toggle('is-current', i === cur);
        l.classList.toggle('is-next', i === nxt);
      });
      const atEnd = index >= leaves.length;
      counter.textContent = !open ? 'Closed' : atEnd ? 'The end, for now' : `No. ${leaves[index].dataset.number} of ${leaves.length}`;
      cursorLabel.textContent = !open ? 'Open' : atEnd ? 'Back' : 'Flip';
    }

    function next() {
      if (busy) return;
      if (!open) { open = true; cover.classList.add('is-open'); play('open'); lock(950); update(); return; }
      if (index >= leaves.length) { nudge(); return; }
      const leaf = leaves[index];
      leaf.classList.add('is-flipping', 'is-flipped');
      setTimeout(() => leaf.classList.remove('is-flipping'), 800);
      index++; play('flip'); lock(720); update();
    }

    function prev() {
      if (busy) return;
      if (!open) { nudge(); return; }
      if (index === 0) { open = false; cover.classList.remove('is-open'); play('open'); lock(950); update(); return; }
      index--; leaves[index].classList.remove('is-flipped'); play('flip'); lock(720); update();
    }

    // buttons, keyboard, click
    root.querySelector('[data-next]')!.addEventListener('click', next);
    root.querySelector('[data-prev]')!.addEventListener('click', prev);
    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['ArrowDown', 'ArrowRight', ' ', 'PageDown'].includes(e.key)) { e.preventDefault(); next(); }
      else if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); prev(); }
    });
    pad.addEventListener('click', () => next());

    // wheel over the pad, one turn per gesture
    let wheelAcc = 0, wheelAt = 0;
    scene.addEventListener('wheel', (e: WheelEvent) => {
      e.preventDefault();
      const now = performance.now();
      if (now - wheelAt < 700) return;
      wheelAcc += e.deltaY;
      if (Math.abs(wheelAcc) > 40) { wheelAcc > 0 ? next() : prev(); wheelAcc = 0; wheelAt = now; }
    }, { passive: false });

    // swipe
    let touchY: number | null = null;
    scene.addEventListener('touchstart', (e: TouchEvent) => { touchY = e.touches[0].clientY; }, { passive: true });
    scene.addEventListener('touchend', (e: TouchEvent) => {
      if (touchY == null) return;
      const dy = e.changedTouches[0].clientY - touchY;
      if (Math.abs(dy) > 36) { dy < 0 ? next() : prev(); }
      touchY = null;
    });

    // tilt toward the pointer, custom cursor
    if (finePointer) {
      root.classList.add('has-cursor');
      scene.addEventListener('pointerenter', () => cursor.classList.add('is-on'));
      scene.addEventListener('pointerleave', () => { cursor.classList.remove('is-on'); pad.style.transform = ''; });
      scene.addEventListener('pointermove', (e: PointerEvent) => {
        const r = scene.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        cursor.style.transform = `translate(${e.clientX - r.left}px, ${e.clientY - r.top}px)`;
        if (!reduce) pad.style.transform = `rotateX(${(-y * 7).toFixed(2)}deg) rotateY(${(x * 9).toFixed(2)}deg)`;
      });
    }

    // gyroscope on phones (iOS asks for permission on a tap)
    const bindOrientation = () => addEventListener('deviceorientation', (e: DeviceOrientationEvent) => {
      if (e.beta == null) return;
      const rx = Math.max(-8, Math.min(8, (e.beta - 50) / 6));
      const ry = Math.max(-8, Math.min(8, (e.gamma || 0) / 6));
      pad.style.transform = `rotateX(${(-rx).toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
    });
    const DOE: any = (window as any).DeviceOrientationEvent;
    if (!reduce && DOE && !finePointer) {
      if (typeof DOE.requestPermission === 'function') {
        tiltBtn.hidden = false;
        tiltBtn.addEventListener('click', async () => {
          try { if ((await DOE.requestPermission()) === 'granted') { bindOrientation(); tiltBtn.hidden = true; } } catch {}
        });
      } else {
        bindOrientation();
      }
    }

    // a quiet paper flick, synthesised, off by default
    try { soundOn = localStorage.getItem('awj-sound') === '1'; } catch {}
    const renderSound = () => { soundBtn.setAttribute('aria-pressed', String(soundOn)); soundBtn.textContent = soundOn ? 'Sound on' : 'Sound off'; };
    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      try { localStorage.setItem('awj-sound', soundOn ? '1' : '0'); } catch {}
      renderSound(); if (soundOn) play('flip');
    });
    function play(kind: 'flip' | 'open') {
      if (!soundOn) return;
      try {
        audio = audio || new (window.AudioContext || (window as any).webkitAudioContext)();
        const ctx = audio;
        const dur = kind === 'open' ? 0.3 : 0.17;
        const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * dur), ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) { const t = i / d.length; d[i] = (Math.random() * 2 - 1) * Math.pow(1 - t, 2.4) * (t < 0.06 ? t / 0.06 : 1); }
        const src = ctx.createBufferSource(); src.buffer = buf;
        const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = kind === 'open' ? 850 : 1700; bp.Q.value = 0.7;
        const g = ctx.createGain(); g.gain.value = kind === 'open' ? 0.5 : 0.32;
        src.connect(bp).connect(g).connect(ctx.destination); src.start();
      } catch {}
    }

    renderSound();
    update();
  });
</script>
