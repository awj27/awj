---
import { getCollection, render } from 'astro:content';
import DesignLayout from '../../../layouts/DesignLayout.astro';
import SiteHeader from '../../../components/v2/SiteHeader.astro';
import SiteFooter from '../../../components/v2/SiteFooter.astro';
import { notebookPages, pad2, pillarLabel } from '../../../data/notebook-pages';

export async function getStaticPaths() {
  return notebookPages.map((p) => ({ params: { number: pad2(p.number) }, props: { page: p } }));
}

const { page } = Astro.props;
const entries = await getCollection('journal');
const entry = entries.find((e) => e.data.awj_number === page.number);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const idx = notebookPages.findIndex((p) => p.number === page.number);
const next = [1, 2, 3].map((d) => notebookPages[(idx + d) % notebookPages.length]);
const date = entry ? new Date(entry.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
const videoId = entry?.data.video_id;
---
<DesignLayout title={`${page.title} · AWJ`} description={`Maxim ${pad2(page.number)} from the Andy Whyte Journal: ${page.title}.`}>
  <SiteHeader />

  <main>
    <article class="entry">
      <header class="entry__head nb-shell">
        <p class="entry__meta nb-meta">
          <span>AWJ No. {pad2(page.number)}</span>
          <span aria-hidden="true">·</span>
          <span class={`nb-pill nb-pill--${page.pillar}`}>{pillarLabel[page.pillar]}</span>
          {date && <><span aria-hidden="true">·</span><span>Filed {date}</span></>}
          {page.provisional && <><span aria-hidden="true">·</span><span>Pillar to confirm</span></>}
        </p>
        <figure class="entry__page">
          <div class="nb-page nb-page--lift">
            <img src={page.src} alt={page.alt} width="1600" height="1096" transition:name="maxim-page" />
          </div>
        </figure>
        <h1 class="entry__title">{page.title}</h1>
      </header>

      <div class="entry__body nb-shell">
        <div class="nb-prose">
          {Content ? <Content /> : (
            <p class="entry__coming">The essay behind this Maxim is being written. The line is on the page. The thinking follows.</p>
          )}
        </div>

        <aside class="entry__side">
          {videoId && (
            <div class="side-card">
              <p class="nb-eyebrow">Watch</p>
              <a class="side-video" href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener">
                <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt={`${page.title}, video thumbnail`} loading="lazy" />
                <span class="side-video__play" aria-hidden="true">&#9654;</span>
              </a>
              <p class="nb-meta">The short version, filmed over the notebook.</p>
            </div>
          )}
          <div class="side-card">
            <p class="nb-eyebrow">Back to the notebook</p>
            <a class="side-link" href={`/design/home/#notebook-hero`}>All the Maxims &rarr;</a>
            <p class="nb-meta">Turn the pages, or jump to the library.</p>
          </div>
        </aside>
      </div>

      <footer class="entry__foot nb-shell">
        <div class="author">
          <img class="author__photo" src="/media/portrait/andy-portrait.jpg" alt="" loading="lazy" />
          <div>
            <p class="author__name">Andy Whyte</p>
            <p class="nb-meta">Founder and CEO of MEDDICC. Author of the best-selling book on sales qualification. Twenty years in sales, one blue notebook.</p>
          </div>
        </div>
      </footer>
    </article>

    <section class="nb-section nb-section--tint">
      <div class="nb-shell">
        <div class="nb-section-head">
          <p class="nb-eyebrow">Next in the notebook</p>
          <h2>Keep turning.</h2>
        </div>
        <div class="nb-grid nb-grid--3">
          {next.map((p) => (
            <a class="next-card" href={p.href}>
              <div class="nb-page"><img src={p.src} alt={p.alt} loading="lazy" /></div>
              <p class="nb-meta">No. {pad2(p.number)}</p>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</DesignLayout>

<style>
  .entry { padding-top: clamp(24px, 4vw, 56px); }
  .entry__head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .entry__meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .entry__page { margin: 8px 0 12px; width: min(760px, 100%); }
  .entry__page img { object-fit: contain; background: var(--nb-paper); }
  .entry__title { font-size: clamp(30px, 4vw, 48px); max-width: 22ch; }
  .entry__coming { color: var(--nb-text-2); font-style: italic; }

  .entry__body { display: grid; grid-template-columns: minmax(0, 66ch) 280px; gap: clamp(32px, 5vw, 80px); justify-content: center; margin-top: clamp(32px, 5vw, 64px); }
  .entry__side { display: flex; flex-direction: column; gap: 20px; }
  .side-card { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1px solid var(--nb-line); border-radius: var(--radius-ui); background: #fff; }
  .side-video { position: relative; display: block; border-radius: 8px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--nb-text); }
  .side-video img { width: 100%; height: 100%; object-fit: cover; opacity: .9; }
  .side-video__play { position: absolute; inset: 0; margin: auto; width: 48px; height: 48px; border-radius: 999px; background: var(--nb-yellow); color: var(--nb-text); display: grid; place-items: center; font-size: 16px; padding-left: 3px; box-shadow: 0 6px 18px rgba(0,0,0,.25); }
  .side-link { font-weight: 600; text-decoration: none; }
  @media (max-width: 900px) { .entry__body { grid-template-columns: minmax(0, 1fr); } .entry__side { flex-direction: row; flex-wrap: wrap; } .side-card { flex: 1 1 260px; } }

  .entry__foot { margin-top: clamp(40px, 5vw, 64px); display: flex; justify-content: center; }
  .author { display: flex; gap: 18px; align-items: center; max-width: 66ch; padding-top: 28px; border-top: 1px solid var(--nb-line); width: 100%; }
  .author__photo { width: 64px; height: 64px; border-radius: 999px; object-fit: cover; flex: none; }
  .author__name { font-weight: 600; }

  .next-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; }
  .next-card .nb-page img { object-fit: contain; background: var(--nb-paper); }
  .next-card .nb-page { transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out); }
  .next-card:hover .nb-page { transform: translateY(-4px) rotate(-.4deg); box-shadow: var(--shadow-lift); }
  .next-card h3 { font-size: 18px; }
</style>
