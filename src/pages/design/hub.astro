---
import DesignLayout from '../../layouts/DesignLayout.astro';
import SiteHeader from '../../components/v2/SiteHeader.astro';
import SiteFooter from '../../components/v2/SiteFooter.astro';
import { notebookPages, pad2 } from '../../data/notebook-pages';

const terms = [
  ['Metrics', 'The quantifiable value the customer gets. Numbers they would defend in their own boardroom.'],
  ['Economic Buyer', 'The person with discretionary control of the budget. The one who can say yes when everyone else has said no.'],
  ['Decision Criteria', 'The formal and informal standards the customer will use to choose. Yours, or your competitor’s.'],
  ['Decision Process', 'The steps, people and timing between a decision and a signature.'],
  ['Paper Process', 'Legal, procurement and security. The part of the process that kills forecasts in the last week of the quarter.'],
  ['Implicate the Pain', 'Connecting the customer’s pain to its cost, and your solution to its relief.'],
  ['Champion', 'A person with power and influence who sells for you when you are not in the room.'],
  ['Competition', 'Anyone or anything competing for the same budget, including doing nothing.'],
];

const faqs = [
  ['What is the difference between MEDDIC, MEDDICC and MEDDPICC?', 'MEDDIC is the original six-letter framework. MEDDICC adds a second C for Competition. MEDDPICC adds a P for Paper Process, the legal and procurement steps that so often decide whether a deal lands this quarter or next. Same thinking, more complete.'],
  ['Is MEDDPICC a sales methodology or a qualification framework?', 'A qualification framework. It tells you how well you understand a deal, not how to run a meeting. Teams pair it with a sales process and a discovery method; it does not replace either.'],
  ['Does MEDDPICC work for smaller deals?', 'Yes, with a lighter touch. The questions are the same, the depth of answer scales with the deal. A thirty-second check against the letters is still faster than losing the deal in month three.'],
  ['How long does it take a team to adopt?', 'The vocabulary takes a week. The habit takes a quarter. The culture, where reps inspect their own deals before anyone asks, takes leadership that uses the framework in every review, not just the big ones.'],
  ['Where should a team start?', 'With Champion and Economic Buyer. If you cannot name both, with evidence, nothing else in the deal is real yet.'],
];

const related = notebookPages.filter((p) => [12, 1, 13].includes(p.number));
---
<DesignLayout title="MEDDPICC and MEDDICC · Topic hub · Design direction 01 · AWJ" draft>
  <SiteHeader />

  <main>
    <section class="hub-hero">
      <div class="nb-shell hub-hero__in">
        <p class="nb-eyebrow">Topic hub</p>
        <h1>MEDDPICC and MEDDICC</h1>
        <p class="nb-lede">The qualification framework behind the best-run sales teams in the world, explained by the person who wrote the book on it and built a company to teach it. Start here, then go as deep as you need.</p>
        <div class="hub-hero__actions">
          <a class="btn btn--blue" href="#definition">What it is</a>
          <a class="btn btn--ghost" href="#faq">Questions answered</a>
        </div>
      </div>
    </section>

    <section class="nb-section" id="definition">
      <div class="nb-shell def">
        <div class="def__copy">
          <p class="nb-eyebrow">In one paragraph</p>
          <h2>Eight letters. One question: do we actually know this deal?</h2>
          <p class="nb-lede">MEDDPICC is a framework for qualifying complex B2B sales. Each letter names something you must understand about a deal before you can trust your forecast: Metrics, Economic Buyer, Decision Criteria, Decision Process, Paper Process, Implicate the Pain, Champion and Competition. It does not tell you what to say in a meeting. It tells you what you still do not know.</p>
          <p class="hub-pos"><span class="nb-hl">Andy's position:</span> most teams use it as a checklist to fill in after the meeting. The teams that win use it as a set of questions to ask before the meeting. Inspect the deal, not the rep.</p>
        </div>
        <div class="def__page">
          <div class="nb-page nb-page--lift">
            <img src="/notebook/pages/awj-12.webp" alt="Handwritten in blue ink: Nobody regrets qualifying out. Signed AWJ, number 12." loading="lazy" />
          </div>
          <p class="nb-meta">The Maxim that sums it up.</p>
        </div>
      </div>
    </section>

    <section class="nb-section nb-section--tint" id="glossary">
      <div class="nb-shell">
        <div class="nb-section-head">
          <p class="nb-eyebrow">The letters</p>
          <h2>Each term, defined plainly.</h2>
        </div>
        <dl class="terms">
          {terms.map(([t, d]) => (
            <div class="term">
              <dt>{t}</dt>
              <dd>{d}</dd>
            </div>
          ))}
        </dl>
        <p class="nb-meta" style="margin-top:20px">Full glossary, with the questions each letter answers, is part of the build.</p>
      </div>
    </section>

    <section class="nb-section">
      <div class="nb-shell">
        <div class="nb-section-head">
          <p class="nb-eyebrow">From the notebook</p>
          <h2>Maxims on qualification.</h2>
        </div>
        <div class="nb-grid nb-grid--3">
          {related.map((p) => (
            <a class="rel-card" href={p.href}>
              <div class="nb-page"><img src={p.src} alt={p.alt} loading="lazy" /></div>
              <p class="nb-meta">No. {pad2(p.number)}</p>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="nb-section nb-section--tint" id="faq">
      <div class="nb-shell faq">
        <div class="nb-section-head">
          <p class="nb-eyebrow">Questions answered</p>
          <h2>The things people actually ask.</h2>
        </div>
        <div class="faq__list">
          {faqs.map(([q, a]) => (
            <details class="faq__item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="nb-section nb-section--blue">
      <div class="nb-shell cta">
        <div>
          <p class="nb-eyebrow">Go further</p>
          <h2>Read the book. Train the team. Book the talk.</h2>
        </div>
        <div class="cta__actions">
          <a class="btn btn--white" href="#">The MEDDICC book</a>
          <a class="btn btn--yellow" href="https://meddicc.com" target="_blank" rel="noopener">MEDDPICC training at meddicc.com</a>
          <a class="btn btn--ghost cta__ghost" href="#">Keynotes</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</DesignLayout>

<style>
  .hub-hero { padding: clamp(40px, 7vw, 96px) 0 clamp(24px, 4vw, 48px); }
  .hub-hero__in { display: flex; flex-direction: column; gap: 18px; max-width: 70ch; }
  .hub-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }

  .def { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .def__copy { display: flex; flex-direction: column; gap: 18px; }
  .hub-pos { font-size: 17px; line-height: 1.6; color: var(--nb-text); }
  .def__page { display: flex; flex-direction: column; gap: 10px; }
  .def__page .nb-page { transform: rotate(1.2deg); }
  @media (max-width: 820px) { .def { grid-template-columns: 1fr; } }

  .terms { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1px; background: var(--nb-line); border: 1px solid var(--nb-line); border-radius: var(--radius-ui); overflow: hidden; }
  .term { background: #fff; padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .term dt { font-weight: 600; font-size: 18px; letter-spacing: -0.01em; }
  .term dt::first-letter { color: var(--nb-cover); }
  .term dd { margin: 0; color: var(--nb-text-2); font-size: 15px; line-height: 1.5; }

  .rel-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; }
  .rel-card .nb-page { transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out); }
  .rel-card:hover .nb-page { transform: translateY(-4px) rotate(-.4deg); box-shadow: var(--shadow-lift); }
  .rel-card h3 { font-size: 18px; }

  .faq__list { max-width: 76ch; }
  .faq__item { border-top: 1px solid var(--nb-line); }
  .faq__item:last-child { border-bottom: 1px solid var(--nb-line); }
  .faq__item summary { cursor: pointer; padding: 18px 40px 18px 0; font-weight: 600; font-size: clamp(17px, 1.4vw, 20px); letter-spacing: -0.01em; list-style: none; position: relative; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 22px; color: var(--nb-cover); font-weight: 400; }
  .faq__item[open] summary::after { content: '\2212'; }
  .faq__item p { padding: 0 0 20px; color: var(--nb-text-2); max-width: 66ch; }

  .cta { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .cta__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta__ghost { border-color: rgba(255,255,255,.4); color: #fff; background: transparent; }
</style>
