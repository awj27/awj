---
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { SITE } from '../data/site';

const topics = ['General', 'Speaking / SKO', 'Advisory', 'Press', 'Book', 'Other'];
---
<SiteLayout
  title="Contact Andy Whyte: speaking, press, advisory"
  description="Speaking enquiries, press, advisory, or just a hello. Every message that comes through this form gets read."
  pageType="contact"
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-page-head__in">
      <p class="nb-eyebrow">Get in touch</p>
      <h1>Say hello.</h1>
      <p class="nb-lede">Speaking, advisory, press, or just a hello. I read everything that comes through this form.</p>
    </div>
  </section>

  <section class="nb-section" style="padding-top:0">
    <div class="nb-shell contact">
      <form class="form" id="contact-form" novalidate>
        <div aria-hidden="true" class="hp"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="field"><span>Your name</span><input type="text" name="name" required autocomplete="name" /></label>
        <label class="field"><span>Email</span><input type="email" name="email" required autocomplete="email" /></label>
        <label class="field"><span>Topic</span>
          <select name="topic">{topics.map((t) => <option value={t}>{t}</option>)}</select>
        </label>
        <label class="field"><span>Message</span><textarea name="message" rows="6" required minlength="10"></textarea></label>
        <button class="btn btn--blue" type="submit" id="contact-submit">Send</button>
        <p class="form__msg" id="contact-msg" aria-live="polite"></p>
      </form>

      <aside class="side nb-stack">
        <div>
          <p class="nb-eyebrow">Or find me on</p>
          <div class="side__social"><SocialIcons tone="dark" size={26} /></div>
        </div>
        <div>
          <p class="nb-eyebrow">Direct</p>
          <p>Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> if you would rather skip the form.</p>
        </div>
        <div class="side__note">
          <p><strong>For speaking enquiries:</strong> include the event date, location, audience size and budget if you have one. It saves a round of email tag. <a href="/speaking/">What I do on stage &rarr;</a></p>
        </div>
      </aside>
    </div>
  </section>
</SiteLayout>

<script>
  function wire() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    // topic from the query string, for example /contact/?topic=speaking
    const want = new URLSearchParams(location.search).get('topic');
    const select = form.querySelector<HTMLSelectElement>('select[name="topic"]');
    if (want && select) {
      const match = Array.from(select.options).find((o) => o.value.toLowerCase().includes(want.toLowerCase()));
      if (match) select.value = match.value;
    }
    const msg = document.getElementById('contact-msg')!;
    const btn = document.getElementById('contact-submit') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (!data.name?.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email || '') || (data.message || '').trim().length < 10) {
        form.dataset.state = 'error';
        msg.textContent = 'Please add your name, a valid email and at least a sentence.';
        return;
      }
      btn.disabled = true; btn.textContent = 'Sending';
      form.dataset.state = '';
      try {
        const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const out = (await res.json()) as { ok: boolean; message?: string; error?: string };
        if (out.ok) { form.dataset.state = 'success'; msg.textContent = out.message ?? 'Sent. I will reply soon.'; form.reset(); btn.textContent = 'Sent'; }
        else { form.dataset.state = 'error'; msg.textContent = out.error ?? 'That did not send. Try again, or email hello@andywhyte.com.'; btn.disabled = false; btn.textContent = 'Send'; }
      } catch {
        form.dataset.state = 'error'; msg.textContent = 'Network error. Try again, or email hello@andywhyte.com.'; btn.disabled = false; btn.textContent = 'Send';
      }
    });
  }
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 620px) 300px; gap: clamp(32px, 6vw, 96px); }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .hp { position: absolute; left: -9999px; opacity: 0; pointer-events: none; height: 0; overflow: hidden; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field span { font-size: 13px; font-weight: 600; color: var(--nb-text-2); }
  .field input, .field select, .field textarea { font: inherit; padding: 12px 14px; border: 1px solid var(--nb-line); border-radius: 12px; background: #fff; color: var(--nb-text); }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 2px solid var(--nb-cover); outline-offset: 2px; }
  .form .btn { align-self: flex-start; }
  .form__msg { font-size: 14px; color: var(--nb-text-3); min-height: 1.2em; }
  .form[data-state="success"] .form__msg { color: var(--nb-ink); font-weight: 600; }
  .form[data-state="error"] .form__msg { color: #B3261E; font-weight: 600; }
  .side__social { margin-top: 8px; }
  .side__note { padding: 16px 18px; border-radius: var(--radius-ui); background: color-mix(in srgb, var(--nb-yellow) 18%, #fff); font-size: 15px; line-height: 1.5; }
</style>
