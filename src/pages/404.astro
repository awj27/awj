---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found | Andy Whyte Journal" description="That page is not in the journal." noIndex>
  <section class="nb-page-head">
    <div class="nb-shell nb-split">
      <div class="nb-page-head__in">
        <p class="nb-eyebrow">404</p>
        <h1>That page is not in the journal.</h1>
        <p class="nb-lede">Either it moved, or it was never written. Nobody regrets qualifying out.</p>
        <div class="nb-page-head__actions">
          <a class="btn btn--blue" href="/">Back to the journal</a>
          <a class="btn btn--ghost" href="/maxims/">The library</a>
          <a class="btn btn--ghost" href="/start-here/">Start here</a>
        </div>
      </div>
      <div class="pad">
        <img src="/notebook/pages/awj-12.webp" alt="Handwritten in blue ink: Nobody regrets qualifying out." loading="eager" width="1600" height="1096" />
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .pad img { max-width: 440px; width: 100%; margin-inline: auto; border-radius: var(--radius-page); box-shadow: var(--shadow-lift); transform: rotate(1.5deg); background: var(--nb-paper); }
</style>
