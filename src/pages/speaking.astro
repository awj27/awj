---
import SiteLayout from '../layouts/SiteLayout.astro';
import FAQ from '../components/v2/FAQ.astro';
import { SITE } from '../data/site';

const faqs = [
  { q: 'Does Andy Whyte do sales kickoff keynotes?', a: 'Yes. Sales kickoff keynotes are one of three formats Andy offers, alongside conference keynotes and master-of-ceremonies engagements. Recent stages include CrowdStrike, Microsoft, Amazon Web Services and Dun and Bradstreet.' },
  { q: 'Where has Andy spoken recently?', a: 'Recent stages include CrowdStrike, Microsoft, Amazon Web Services and Dun and Bradstreet. He has also delivered keynotes for Net Health, MRI Software and Arctic Wolf Networks.' },
  { q: 'Is Andy Whyte available for virtual keynotes?', a: 'Yes. Andy keynotes in person worldwide and virtually, for sales kickoffs, leadership offsites and revenue summits.' },
  { q: 'What is a typical Andy Whyte SKO session?', a: 'A bespoke session built around the team’s actual deals, stage gates and objection patterns. It goes deeper than a generic keynote: the team leaves with frameworks they can apply on Monday, not motivational soundbites that fade by Tuesday.' },
  { q: 'What is the KEYGOAT?', a: 'The KEYGOAT mindset: it is not that we think we are the greatest keynote speakers of all time, it is that we treat every single keynote as if it has to be the greatest of all time. Painstakingly curated, wildly creative, and engineered to send every audience member out fired up to take immediate action.' },
  { q: 'How do I book Andy to speak?', a: 'Use the Contact page with the topic set to Speaking, or email hello@andywhyte.com. Include the event date, location, audience size and budget if you have one. Andy speaks on enterprise sales, MEDDICC, sales as a thinking discipline, and the patterns that separate A-players from theatre.' },
];

const formats = [
  { icon: '/media/icons/keynote-icon.webp', title: 'Keynote', blurb: 'A 30 to 60 minute talk built around the MEDDICC framework: the principles, the failure modes and the patterns that separate A-players from theatre.' },
  { icon: '/media/icons/sko-icon.webp', title: 'Sales kickoff', blurb: 'A bespoke session for your SKO, designed around your deals, your stage gates and your objection patterns. Goes deeper than a generic keynote.' },
  { icon: '/media/icons/mc-icon.webp', title: 'Master of ceremonies', blurb: 'Host your event end to end. Set the tone, hold the energy, conduct the panels, deliver the close. Best for SKOs and revenue summits.' },
];

const testimonials = [
  { photo: '/media/clients/Michael.webp', name: 'Michael Sentonas', role: 'President, CrowdStrike', quote: 'We loved having Andy Whyte there, great session with incredible passion and he absolutely nailed it!' },
  { photo: '/media/clients/Susan.webp', name: 'Susan Kinser', role: 'Executive Revenue Enablement Manager, Net Health', quote: 'So grateful that Andy flew halfway across the world to ignite something BIG within our organization to ensure we continue our growth and success.' },
  { photo: '/media/clients/1621958247894.webp', name: 'Mandira Mehra', role: 'Chief Marketing Officer, MRI Software', quote: 'Andy helped take our GKO to the next level.' },
  { photo: '/media/clients/Deanna.webp', name: 'Deanna Kane', role: 'Account Executive', quote: 'Andy Whyte from MEDDICC, was a game-changer.' },
  { photo: '/media/clients/Hannah.webp', name: 'Hannah Klug', role: 'VP Sales Enablement, Arctic Wolf Networks', quote: 'OMG Andy owned the stage!' },
  { photo: '/media/clients/Adeeb.webp', name: 'Adeeb Chowdhury', role: 'Sales Leader, CrowdStrike', quote: "Thanks for the awesome sessions Andy! It's been an awesome first half of the FY since SKO, looking forward to accelerating forward with MEDDPICC continuously in this second half!" },
];

const logos = [
  { src: '/media/clients/CS_Logo_2022_In-Line_All-Red_RGB_1.png', alt: 'CrowdStrike' },
  { src: '/media/clients/Microsoft_logo.webp', alt: 'Microsoft' },
  { src: '/media/clients/AWS-logo.svg', alt: 'Amazon Web Services' },
  { src: '/media/clients/Dun_and_Bradstreet_wordmark.svg.webp', alt: 'Dun and Bradstreet' },
];

const service = {
  '@type': 'Service',
  '@id': `${SITE.url}/speaking/#service`,
  name: 'Andy Whyte keynote speaking',
  description: 'Keynotes, sales kickoff sessions and master-of-ceremonies services for SKOs, leadership offsites and revenue summits.',
  provider: { '@id': `${SITE.url}/#andy` },
  serviceType: 'Keynote Speaking',
  url: `${SITE.url}/speaking/`,
  areaServed: 'Worldwide',
};
---
<SiteLayout
  title="Andy Whyte, keynote speaker: SKOs, sales conferences, revenue summits"
  description="Keynotes, sales kickoff sessions and MC for revenue summits. CrowdStrike, Microsoft, AWS, Dun and Bradstreet. In person worldwide and virtual. Enquire about a date."
  pageType="speaking"
  schema={[service]}
  breadcrumbs={[{ name: 'Speaking', href: '/speaking/' }]}
>
  <section class="hero" id="reel">
    <video class="hero__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="/media/video/sko-keynote-reel.mp4" type="video/mp4" />
    </video>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="nb-shell hero__in">
      <p class="nb-eyebrow">Keynotes and SKOs</p>
      <h1>Keynotes that change the deal, not the slide.</h1>
      <p class="nb-lede">Painstakingly curated, wildly creative keynotes engineered to entertain, ignite, and send every audience member out fired up to take immediate action.</p>
      <div class="nb-page-head__actions">
        <a class="btn btn--yellow" href="/contact/?topic=speaking">Enquire about a date</a>
        <a class="btn btn--ghost hero__ghost" href="/keynote-speaking/">What I speak about</a>
      </div>
    </div>
  </section>

  <section class="logos">
    <div class="nb-shell">
      <p class="nb-eyebrow">Recent stages</p>
      <ul class="logos__row">
        {logos.map((l) => <li><img src={l.src} alt={l.alt} loading="lazy" decoding="async" /></li>)}
      </ul>
    </div>
  </section>

  <section class="nb-section">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Three formats</p>
        <h2>What I do.</h2>
      </div>
      <div class="nb-grid nb-grid--3">
        {formats.map((f) => (
          <div class="nb-card">
            <img class="fmt__icon" src={f.icon} alt="" loading="lazy" width="56" height="56" />
            <h3>{f.title}</h3>
            <p class="fmt__blurb">{f.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">The mindset</p>
        <h2>The KEYGOAT.</h2>
        <p class="nb-lede">It is not that we think we are the greatest keynote speakers of all time. It is that we treat every single keynote as if it has to be the greatest of all time.</p>
      </div>
      <div class="reel">
        <iframe
          id="keygoat-video"
          src="https://www.youtube-nocookie.com/embed/4hATA2kXYeQ?rel=0&modestbranding=1"
          title="The KEYGOAT, Andy Whyte"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          data-yt-track
          data-yt-title="The KEYGOAT"
          data-yt-type="longform"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="nb-section">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">From the room</p>
        <h2>What people say.</h2>
      </div>
      <ul class="nb-grid nb-grid--3 quotes">
        {testimonials.map((t) => (
          <li class="nb-card quote">
            <p class="quote__text">"{t.quote}"</p>
            <div class="quote__by">
              <img src={t.photo} alt="" loading="lazy" width="48" height="48" />
              <div><span class="quote__name">{t.name}</span><span class="quote__role">{t.role}</span></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FAQ items={faqs} />

  <section class="nb-section nb-section--blue">
    <div class="nb-shell cta">
      <div class="nb-stack">
        <p class="nb-eyebrow">Booking</p>
        <h2>Bring this to your team.</h2>
        <p class="nb-lede">For SKOs, leadership offsites and revenue summits. In person worldwide, and virtually.</p>
      </div>
      <div class="nb-page-head__actions">
        <a class="btn btn--yellow" href="/contact/?topic=speaking">Enquire about a date</a>
        <a class="btn btn--ghost hero__ghost" href="/sales-keynote-speaker-uk/">Keynotes in the UK and Europe</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { position: relative; overflow: hidden; background: var(--nb-text); color: #fff; min-height: min(640px, 80svh); display: flex; align-items: center; }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.85); }
  .hero__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(26,33,64,.88) 0%, rgba(26,33,64,.7) 40%, rgba(26,33,64,.25) 100%), linear-gradient(to bottom, rgba(26,33,64,0) 60%, rgba(26,33,64,.5) 100%); }
  .hero__in { position: relative; display: flex; flex-direction: column; gap: 18px; padding: clamp(56px, 9vw, 120px) 0; max-width: 60ch; }
  .hero h1 { color: #fff; }
  .hero .nb-eyebrow { color: var(--nb-yellow); }
  .hero .nb-lede { color: rgba(255,255,255,.85); }
  .hero__ghost { border-color: rgba(255,255,255,.45); color: #fff; background: transparent; }
  .hero__ghost:hover { border-color: #fff; }
  @media (max-width: 720px) { .hero__overlay { background: linear-gradient(to bottom, rgba(26,33,64,.6), rgba(26,33,64,.88)); } }
  @media (prefers-reduced-motion: reduce) { .hero__video { display: none; } }

  .logos { padding: clamp(28px, 4vw, 48px) 0; border-bottom: 1px solid var(--nb-line); }
  .logos__row { margin: 16px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; align-items: center; }
  .logos__row li { display: flex; justify-content: center; }
  .logos__row img { max-height: 48px; max-width: 100%; width: auto; opacity: .8; filter: grayscale(1); transition: opacity .2s, filter .2s; }
  .logos__row img:hover { opacity: 1; filter: none; }
  @media (min-width: 720px) { .logos__row { grid-template-columns: repeat(4, 1fr); } }

  .fmt__icon { width: 56px; height: 56px; object-fit: contain; }
  .fmt__blurb { color: var(--nb-text-2); font-size: 15px; line-height: 1.5; }
  .reel { position: relative; aspect-ratio: 16 / 9; max-width: 1100px; margin: 0 auto; border-radius: var(--radius-ui); overflow: hidden; background: var(--nb-text); box-shadow: var(--shadow-lift); }
  .reel iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .quotes { list-style: none; padding: 0; margin: 0; }
  .quote__text { flex: 1; font-size: 17px; line-height: 1.55; }
  .quote__by { display: flex; align-items: center; gap: 12px; }
  .quote__by img { width: 48px; height: 48px; border-radius: 999px; object-fit: cover; filter: grayscale(1); }
  .quote__name { display: block; font-weight: 600; font-size: 14px; }
  .quote__role { display: block; font-size: 12px; color: var(--nb-text-2); }
  .cta { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; }
  @media (max-width: 820px) { .cta { grid-template-columns: 1fr; } }
</style>
