---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SubscribeForm from '../../components/v2/SubscribeForm.astro';
import { pillarLabel, pad2, pageFor, pageImage, ogImage } from '../../data/notebook-pages';
import { SITE, HUBS } from '../../data/site';
import { entryHref, entrySlug, readingTime, plainExcerpt, formatDate, byNumberDesc } from '../../lib/maxims';

export async function getStaticPaths() {
  const entries = await getCollection('journal', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const n = entry.data.awj_number;
const page = pageFor(n);
const image = page?.src ?? pageImage(n);
const alt = page?.alt ?? `Handwritten Maxim ${pad2(n)}: ${entry.data.title}`;
const description = entry.data.excerpt ?? plainExcerpt(entry.body ?? '') ?? entry.data.title;
const published = entry.data.date;
const modified = entry.data.modified ?? entry.data.date;
const rt = readingTime(entry.body ?? '');
const url = `${SITE.url}${entryHref(entry)}`;

const all = (await getCollection('journal', (e) => !e.data.draft && e.id !== entry.id)).sort(byNumberDesc);
const readNext = [...all.filter((e) => e.data.pillar === entry.data.pillar), ...all.filter((e) => e.data.pillar !== entry.data.pillar)].slice(0, 3);

const hubs = await getCollection('hubs');
const partOf = hubs.filter((h) => h.data.maxims.includes(n)).map((h) => ({ title: h.data.title, href: `/${h.id}/` }));

const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: entry.data.title,
  alternativeHeadline: `AWJ No. ${pad2(n)}`,
  description,
  image: [`${SITE.url}${ogImage(n)}`, `${SITE.url}${image}`],
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@id': `${SITE.url}/#andy` },
  publisher: { '@id': `${SITE.url}/#org` },
  mainEntityOfPage: url,
  articleSection: pillarLabel[entry.data.pillar],
  inLanguage: 'en-GB',
  isPartOf: { '@id': `${SITE.url}/#website` },
};
const video = entry.data.video_id ? [{
  '@type': 'VideoObject',
  '@id': `${url}#video`,
  name: `${entry.data.title}, the video`,
  description,
  thumbnailUrl: `https://i.ytimg.com/vi/${entry.data.video_id}/hqdefault.jpg`,
  uploadDate: published.toISOString(),
  embedUrl: `https://www.youtube-nocookie.com/embed/${entry.data.video_id}`,
  contentUrl: `https://www.youtube.com/watch?v=${entry.data.video_id}`,
  author: { '@id': `${SITE.url}/#andy` },
}] : [];
---
<SiteLayout
  title={`${entry.data.title}: AWJ No. ${pad2(n)} | Andy Whyte Journal`}
  description={description}
  ogImage={ogImage(n)}
  ogType="article"
  pageType="maxim"
  pillar={entry.data.pillar}
  awjNumber={n}
  schema={[article, ...video]}
  breadcrumbs={[{ name: 'Maxims', href: '/maxims/' }, { name: `No. ${pad2(n)}`, href: entryHref(entry) }]}
>
  <article class="entry">
    <header class="entry__head nb-shell">
      <p class="entry__meta nb-meta">
        <span>AWJ No. {pad2(n)}</span>
        <span aria-hidden="true">·</span>
        <a class={`nb-pill nb-pill--${entry.data.pillar}`} href={`/pillars/${entry.data.pillar}/`}>{pillarLabel[entry.data.pillar]}</a>
        <span aria-hidden="true">·</span>
        <time datetime={published.toISOString()}>Filed {formatDate(published)}</time>
        <span aria-hidden="true">·</span>
        <span>{rt}</span>
      </p>
      <figure class="entry__page">
        <div class="nb-page nb-page--lift">
          <img src={image} alt={alt} width="1600" height="1096" transition:name="maxim-page" />
        </div>
      </figure>
      <h1 class="entry__title">{entry.data.title}</h1>
    </header>

    <div class="entry__body nb-shell">
      <div class="nb-prose" data-sheet-prose>
        <Content />
      </div>

      <aside class="entry__side">
        {entry.data.video_id && (
          <div class="side-card" data-sheet-video>
            <p class="nb-eyebrow">Watch</p>
            <div class="side-video">
              <iframe
                id={`maxim-video-${n}`}
                src={`https://www.youtube-nocookie.com/embed/${entry.data.video_id}?rel=0&modestbranding=1`}
                title={`${entry.data.title}, the video`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                data-yt-track
                data-yt-title={entry.data.title}
                data-yt-type="longform"
              ></iframe>
            </div>
            <p class="nb-meta">The short version, filmed over the journal.</p>
          </div>
        )}
        {partOf.length > 0 && (
          <div class="side-card">
            <p class="nb-eyebrow">Part of</p>
            {partOf.map((h) => <a class="side-link" href={h.href}>{h.title} &rarr;</a>)}
            <p class="nb-meta">The hub: Maxims, questions answered, the frameworks.</p>
          </div>
        )}
        <div class="side-card">
          <p class="nb-eyebrow">Back to the journal</p>
          <a class="side-link" href={`/#awj-${pad2(n)}`}>Back to this page in the journal &rarr;</a>
          <a class="side-link" href="/maxims/">The library &rarr;</a>
        </div>
      </aside>
    </div>

    <footer class="entry__foot nb-shell">
      <div class="author">
        <img class="author__photo" src="/media/portrait/andy-portrait.jpg" alt="" loading="lazy" width="128" height="128" />
        <div>
          <p class="author__name"><a href="/about/">Andy Whyte</a></p>
          <p class="nb-meta">Founder and CEO of MEDDICC. Author of the best-selling book MEDDICC. Twenty years in sales, one blue journal.</p>
        </div>
      </div>
    </footer>
  </article>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Next in the journal</p>
        <h2>Keep turning.</h2>
      </div>
      <div class="nb-grid nb-grid--3">
        {readNext.map((e) => {
          const p = pageFor(e.data.awj_number);
          return (
            <a class="next-card" href={entryHref(e)}>
              <div class="nb-page"><img src={p?.src ?? pageImage(e.data.awj_number)} alt={p?.alt ?? e.data.title} loading="lazy" width="1600" height="1096" /></div>
              <p class="nb-meta">No. {pad2(e.data.awj_number)} · {pillarLabel[e.data.pillar]}</p>
              <h3>{e.data.title}</h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="nb-section">
    <div class="nb-shell entry__sub">
      <div class="nb-stack">
        <p class="nb-eyebrow">The journal</p>
        <h2>New Maxims, as they are written.</h2>
        <p class="nb-lede">No schedule promised. When a page gets filled in, you get the Maxim.</p>
      </div>
      <SubscribeForm source={`maxim-${pad2(n)}`} compact />
    </div>
  </section>
</SiteLayout>

<style>
  .entry { padding-top: clamp(24px, 4vw, 56px); }
  .entry__head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .entry__meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .entry__meta a.nb-pill { text-decoration: none; }
  .entry__page { margin: 8px 0 12px; width: min(760px, 100%); }
  .entry__page img { object-fit: contain; background: var(--nb-paper); }
  .entry__title { font-size: clamp(30px, 4vw, 48px); max-width: 22ch; }

  .entry__body { display: grid; grid-template-columns: minmax(0, 66ch) 280px; gap: clamp(32px, 5vw, 80px); justify-content: center; margin-top: clamp(32px, 5vw, 64px); }
  .entry__side { display: flex; flex-direction: column; gap: 20px; }
  .side-card { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1px solid var(--nb-line); border-radius: var(--radius-ui); background: #fff; }
  .side-video { position: relative; border-radius: 8px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--nb-text); }
  .side-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .side-link { font-weight: 600; text-decoration: none; }
  .side-link:hover { text-decoration: underline; }
  @media (max-width: 900px) { .entry__body { grid-template-columns: minmax(0, 1fr); } .entry__side { flex-direction: row; flex-wrap: wrap; } .side-card { flex: 1 1 260px; } }

  .entry__foot { margin-top: clamp(40px, 5vw, 64px); display: flex; justify-content: center; }
  .author { display: flex; gap: 18px; align-items: center; max-width: 66ch; padding-top: 28px; border-top: 1px solid var(--nb-line); width: 100%; }
  .author__photo { width: 64px; height: 64px; border-radius: 999px; object-fit: cover; flex: none; }
  .author__name { font-weight: 600; }
  .author__name a { text-decoration: none; color: inherit; }

  .next-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; }
  .next-card .nb-page img { object-fit: contain; background: var(--nb-paper); }
  .next-card .nb-page { transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out); }
  .next-card:hover .nb-page { transform: translateY(-4px) rotate(-.4deg); box-shadow: var(--shadow-lift); }
  .next-card h3 { font-size: 18px; }

  .entry__sub { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 820px) { .entry__sub { grid-template-columns: 1fr; } }
</style>
