---
import SiteLayout from '../layouts/SiteLayout.astro';
import FAQ from '../components/v2/FAQ.astro';
import { SITE, HUBS } from '../data/site';
import { pillarInfo } from '../data/notebook-pages';

const faqs = [
  { q: 'Who is Andy Whyte?', a: `Andy Whyte is the founder and CEO of MEDDICC, the sales qualification methodology and platform used by enterprise B2B sales teams worldwide. He wrote MEDDICC, the best-selling book on sales qualification, with over ${SITE.facts.copies} copies sold, and more than ${SITE.facts.graduates} people have graduated from the MEDDICC Masterclass built on it. Before founding MEDDICC in 2021 he spent twenty years as a seller and sales leader at companies including Oracle, Sprinklr, Tealium, Branch and Poq.` },
  { q: 'What is the Andy Whyte Journal?', a: 'A notebook of principles, written by hand and published online. Each entry is a Maxim, a single line, with the essay behind it. The Maxims sit in three pillars: Sales, Founder and Human. There is no fixed schedule; a new page is published when it is written.' },
  { q: 'What does Andy do?', a: 'He runs MEDDICC. He keynotes at sales kickoffs, sales conferences and revenue summits for organisations including CrowdStrike, Microsoft, Amazon Web Services and Dun and Bradstreet. He writes the journal.' },
  { q: 'How can I work with Andy?', a: 'For keynotes, sales kickoffs and master-of-ceremonies engagements, see the Speaking page or use the Contact page. For MEDDICC training, certification and sales enablement programmes, visit meddicc.com. For press and other enquiries, use the Contact page.' },
  { q: 'What topics does Andy write and speak about?', a: 'MEDDPICC and MEDDICC, sales leadership, keynote speaking for sales teams, and imposter syndrome. Each has its own hub on this site, with the essays, the questions people ask and the frameworks behind the thinking.' },
];

const milestones = [
  { year: '2019 to 2021', role: 'MD, EMEA',           company: 'Branch',                    logo: '/media/career-logos/branch.png' },
  { year: '2017 to 2019', role: 'Head of Sales',      company: 'Poq',                       logo: '/media/career-logos/poq.png' },
  { year: '2017',         role: 'Sales Director',     company: 'Tealium',                   logo: '/media/career-logos/tealium.png' },
  { year: '2015 to 2017', role: 'Account Executive',  company: 'Sprinklr',                  logo: '/media/career-logos/sprinklr.png' },
  { year: '2013 to 2015', role: 'Account Executive',  company: 'Oracle',                    logo: '/media/career-logos/oracle.png' },
  { year: '2008 to 2013', role: 'VP of Sales',        company: 'ECI Software Solutions',    logo: '/media/career-logos/eci.png' },
  { year: '2006 to 2008', role: 'Account Executive',  company: 'ECI Software Solutions',    logo: '/media/career-logos/eci.png' },
  { year: '2004 to 2006', role: 'Head of Sales',      company: 'Everest Home Improvements', logo: '/media/career-logos/everest.png' },
  { year: '2004',         role: 'Store Manager',      company: 'Phones 4u',                 logo: '/media/career-logos/phones4u.png' },
  { year: '2001 to 2004', role: 'Entertainer and DJ', company: 'Potters Resort',            logo: '/media/career-logos/potters.png' },
];

const profile = { '@type': 'ProfilePage', '@id': `${SITE.url}/about/#profile`, url: `${SITE.url}/about/`, name: 'About Andy Whyte', mainEntity: { '@id': `${SITE.url}/#andy` } };
---
<SiteLayout
  title="About Andy Whyte: founder and CEO of MEDDICC, author, keynote speaker"
  description="Andy Whyte. Founder and CEO of MEDDICC, author of the best-selling book on sales qualification, keynote speaker. Twenty years in sales, and why the journal exists."
  pageType="about"
  schema={[profile]}
  breadcrumbs={[{ name: 'About', href: '/about/' }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-split">
      <div class="nb-page-head__in">
        <p class="nb-eyebrow">Who is this?</p>
        <h1>Andy Whyte. Founder and CEO, best-selling author, dad, human.</h1>
        <p class="nb-lede">Outcome-oriented, results-driven. MEDDIC superfan. Twenty years in sales, one company, one book, one blue notebook.</p>
        <div class="nb-page-head__actions">
          <a class="btn btn--blue" href="/speaking/">Book Andy to speak</a>
          <a class="btn btn--ghost" href="/maxims/">Read the Maxims</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/media/portrait/andy-leather-jacket.webp" alt="Andy Whyte, founder and CEO of MEDDICC" loading="eager" decoding="async" width="800" height="1000" />
      </div>
    </div>
  </section>

  <section class="nb-section" style="padding-top:clamp(24px,3vw,48px)">
    <div class="nb-shell">
      <div class="nb-prose">
        <h2>From B-player to founder.</h2>
        <p>I am the founder and CEO of MEDDICC. Before that, I spent twenty years as an individual contributor and sales leader.</p>
        <p>There was a time early in my career when I felt like no matter how much work I put in, I was playing sales on hard mode while everyone around me was playing it on easy mode.</p>
        <p>That was when I discovered MEDDIC and unlocked my full potential as a salesperson. It was like I went from the B-player version of myself to the A-player version.</p>
        <p>I realised that while the best organisations I knew all used MEDDIC, nobody was talking about it. I started to write about it, and quickly found a keen audience.</p>
        <p>Blog posts turned into a book, and the book turned into a bestseller. Today, over {SITE.facts.copies} people have read it, and more than {SITE.facts.graduates} have graduated from the Masterclass built on it.</p>
      </div>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell journey">
      <div class="nb-section-head">
        <p class="nb-eyebrow">The long way round</p>
        <h2>From entertainer to founder. Twenty years. One trajectory.</h2>
      </div>
      <div class="apex">
        <img class="apex__logo" src="/media/career-logos/meddicc.png" alt="" loading="lazy" />
        <div>
          <p class="nb-meta">2021 to present</p>
          <h3>Founder and CEO · MEDDICC</h3>
          <p class="apex__also">Also Creative Director, MEDDICC MEDIA, since 2022.</p>
        </div>
      </div>
      <ol class="path" aria-label="Career milestones">
        {milestones.map((m) => (
          <li class="path__row">
            <span class="path__logo"><img src={m.logo} alt="" loading="lazy" /></span>
            <span class="path__year nb-meta">{m.year}</span>
            <span class="path__role">{m.role}<span class="path__co"> · {m.company}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="nb-section">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Why the journal exists</p>
        <h2>A notebook page that earned the right to be on a billboard.</h2>
        <p class="nb-lede">The public form of the journal I keep in private: applied thinking from someone who has done both the work and the worrying. Three pillars.</p>
      </div>
      <div class="nb-grid nb-grid--3">
        {(['sales', 'founder', 'human'] as const).map((p) => (
          <a class="nb-card pillar-card" href={`/pillars/${p}/`}>
            <span class={`nb-pill nb-pill--${p}`}>{pillarInfo[p].tag}</span>
            <h3>{pillarInfo[p].label}</h3>
            <p>{pillarInfo[p].description}</p>
          </a>
        ))}
      </div>
      <p class="nb-note" style="margin-top:22px">Four subjects get their own hubs: {HUBS.map((h, i) => <><a href={`/${h.slug}/`}>{h.title}</a>{i < HUBS.length - 1 ? ', ' : '.'}</>)}</p>
    </div>
  </section>

  <FAQ items={faqs} />
</SiteLayout>

<style>
  .portrait img { border-radius: var(--radius-ui); box-shadow: var(--shadow-page); aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; width: 100%; }
  @media (max-width: 820px) { .portrait { max-width: 380px; } }
  .journey { max-width: 720px; }
  .apex { display: grid; grid-template-columns: 64px 1fr; gap: 18px; align-items: center; padding: 22px; background: #fff; border: 1px solid var(--nb-line); border-radius: var(--radius-ui); box-shadow: var(--shadow-page); margin-bottom: 14px; }
  .apex__logo { width: 64px; height: 64px; border-radius: 999px; object-fit: contain; background: #fff; border: 1px solid var(--nb-line); padding: 8px; }
  .apex h3 { font-size: 22px; margin: 2px 0 4px; }
  .apex__also { font-size: 14px; color: var(--nb-text-2); }
  .path { margin: 0; padding: 0; list-style: none; position: relative; }
  .path::before { content: ''; position: absolute; left: 23px; top: 12px; bottom: 12px; border-left: 2px dashed var(--nb-line); }
  .path__row { position: relative; display: grid; grid-template-columns: 46px 120px 1fr; gap: 14px; align-items: center; padding: 6px 0; }
  .path__logo { width: 46px; height: 46px; border-radius: 999px; background: #fff; border: 1px solid var(--nb-line); display: grid; place-items: center; overflow: hidden; }
  .path__logo img { width: 72%; height: 72%; object-fit: contain; }
  .path__role { font-weight: 600; }
  .path__co { font-weight: 400; color: var(--nb-text-2); }
  @media (max-width: 560px) { .path__row { grid-template-columns: 40px 1fr; } .path__year { grid-column: 2; } .path__role { grid-column: 2; } .path::before { left: 20px; } }
  .pillar-card { text-decoration: none; color: inherit; }
  .pillar-card .nb-pill { align-self: flex-start; }
  .pillar-card p { color: var(--nb-text-2); font-size: 15px; line-height: 1.5; }
</style>
