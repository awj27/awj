---
import SiteLayout from '../layouts/SiteLayout.astro';
import { VIDEOS } from '../lib/videos';
import { pillarLabel } from '../data/notebook-pages';

const longform = VIDEOS.filter((v) => v.type === 'longform');
const shorts = VIDEOS.filter((v) => v.type === 'short');
const featured = longform[0];

const gallery = [
  { src: '/media/gallery/DSC03093-scaled.webp', alt: 'Andy Whyte, founder and CEO of MEDDICC' },
  { src: '/media/gallery/DSC03017-2.webp', alt: 'Andy Whyte portrait' },
  { src: '/media/gallery/DSC03060-scaled.jpg', alt: 'Andy Whyte speaking on stage' },
  { src: '/media/gallery/DSC02799-2-scaled.webp', alt: 'Andy Whyte at a keynote' },
  { src: '/media/gallery/DSC03231.webp', alt: 'Andy Whyte, candid' },
  { src: '/media/gallery/DSC02731-2-scaled.webp', alt: 'Andy Whyte off stage' },
  { src: '/media/gallery/DSC02886-scaled.webp', alt: 'Andy Whyte portrait' },
];
const candids = ['img_4156.jpg', 'img_4234.jpg', 'img_4233_2.jpg', 'img_4212.jpg', 'img_4211.jpg', 'img_4122.jpg', 'img_4276.jpg', 'img_4288.jpg', 'img_4967.jpg', 'img_5122.jpg', '2917b53f-0436-4802-98e7-091521d23217.jpg', 'img_5283.jpg', 'img_5316.jpg', '432bffbc-5983-493b-b79c-3ccc938350e3.jpg', '7de8a61e-c393-4d1c-92db-1e9bfd96bb6f.jpg', 'd078843e-d199-4126-9223-904d32d6f884.jpg', 'img_5671.jpg'].map((f) => `/media/candids/${f}`);
---
<SiteLayout
  title="Media: videos, headshots and candids | Andy Whyte"
  description="Andy Whyte's long-form videos and shorts, press headshots and behind-the-scenes photos. Everything an event organiser or editor needs."
  pageType="media"
  breadcrumbs={[{ name: 'Media', href: '/media/' }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-page-head__in">
      <p class="nb-eyebrow">Media</p>
      <h1>Videos, headshots and candids.</h1>
      <p class="nb-lede">{longform.length} long-form videos and {shorts.length} shorts from the channel, plus the photographs an organiser or editor might need.</p>
    </div>
  </section>

  {featured && (
    <section class="nb-section" style="padding-top:0" id="videos">
      <div class="nb-shell">
        <div class="player">
          <iframe
            id="media-player"
            src={`https://www.youtube-nocookie.com/embed/${featured.id}?rel=0&modestbranding=1`}
            title={featured.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            data-yt-track
            data-yt-title={featured.title}
            data-yt-type="longform"
          ></iframe>
        </div>
        <p class="nb-meta" style="margin-top:12px" data-player-title>Now playing: {featured.title}</p>
        <div class="nb-section-head" style="margin:clamp(28px,4vw,48px) 0 20px">
          <p class="nb-eyebrow">Long-form</p>
          <h2>The videos.</h2>
        </div>
        <ul class="thumbs">
          {longform.map((v) => (
            <li>
              <button type="button" class="thumb" data-video={v.id} data-title={v.title} data-type="longform">
                <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />
                <span class="thumb__title">{v.title}</span>
                <span class="nb-meta">{pillarLabel[v.pillar]}{v.awjNumber ? ` · Maxim ${v.awjNumber}` : ''}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {shorts.length > 0 && (
    <section class="nb-section nb-section--tint">
      <div class="nb-shell">
        <div class="nb-section-head">
          <p class="nb-eyebrow">Shorts</p>
          <h2>The short ones.</h2>
        </div>
        <ul class="shorts">
          {shorts.map((v) => (
            <li>
              <a class="short" href={`https://www.youtube.com/shorts/${v.id}`} target="_blank" rel="noopener">
                <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
                <span class="thumb__title">{v.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="nb-section" id="photos">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Headshots</p>
        <h2>For programmes and press.</h2>
        <p class="nb-lede">Right-click to save. Credit is appreciated but not required.</p>
      </div>
      <div class="masonry">
        {gallery.map((g) => <a href={g.src} target="_blank" rel="noopener"><img src={g.src} alt={g.alt} loading="lazy" /></a>)}
      </div>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Candids</p>
        <h2>Behind the scenes.</h2>
      </div>
      <div class="masonry masonry--4">
        {candids.map((src) => <a href={src} target="_blank" rel="noopener"><img src={src} alt="Andy Whyte, behind the scenes" loading="lazy" /></a>)}
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  function wire() {
    const player = document.getElementById('media-player') as HTMLIFrameElement | null;
    if (!player || player.dataset.ready) return;
    player.dataset.ready = '1';
    const title = document.querySelector<HTMLElement>('[data-player-title]');
    document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.video!, t = b.dataset.title || '';
      const api = (window as any).AWJYT;
      if (api && typeof api.changeVideo === 'function') api.changeVideo('media-player', id, { title: t, type: b.dataset.type });
      else player.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1&autoplay=1`;
      if (title) title.textContent = `Now playing: ${t}`;
      player.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
  }
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .player { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-ui); overflow: hidden; background: var(--nb-text); box-shadow: var(--shadow-lift); }
  .player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .thumbs, .shorts { margin: 0; padding: 0; list-style: none; display: grid; gap: 18px; }
  .thumbs { grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .shorts { grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); }
  .thumb, .short { display: flex; flex-direction: column; gap: 8px; text-align: left; background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; text-decoration: none; }
  .thumb img, .short img { width: 100%; border-radius: 10px; object-fit: cover; aspect-ratio: 16 / 9; transition: transform .2s var(--ease-out); }
  .short img { aspect-ratio: 9 / 16; object-position: center; }
  .thumb:hover img, .short:hover img { transform: translateY(-2px); }
  .thumb__title { font-weight: 600; font-size: 14px; line-height: 1.3; }
  .masonry { column-count: 3; column-gap: 16px; }
  .masonry--4 { column-count: 4; }
  .masonry a { display: block; margin-bottom: 16px; break-inside: avoid; border-radius: 10px; overflow: hidden; }
  .masonry img { width: 100%; display: block; transition: transform .25s var(--ease-out); }
  .masonry a:hover img { transform: scale(1.02); }
  @media (max-width: 760px) { .masonry { column-count: 2; } .masonry--4 { column-count: 2; } }
</style>
