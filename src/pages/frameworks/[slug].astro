---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pageFor, pad2, pillarLabel } from '../../data/notebook-pages';
import { SITE, HUBS } from '../../data/site';
import { entryHref } from '../../lib/maxims';

export async function getStaticPaths() {
  const frameworks = await getCollection('frameworks');
  return frameworks.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const url = `${SITE.url}/frameworks/${entry.id}/`;
const hub = d.hub ? HUBS.find((h) => h.slug === d.hub) : undefined;
const journal = await getCollection('journal', (e) => !e.data.draft);
const maxims = d.maxims.map((n: number) => { const e = journal.find((x) => x.data.awj_number === n); const p = pageFor(n); return e && p ? { n, href: entryHref(e), page: p } : null; }).filter(Boolean) as { n: number; href: string; page: NonNullable<ReturnType<typeof pageFor>> }[];

const howTo = d.steps.length ? [{
  '@type': 'HowTo',
  '@id': `${url}#howto`,
  name: d.name,
  description: d.oneLiner,
  step: d.steps.map((s: string, i: number) => ({ '@type': 'HowToStep', position: i + 1, text: s })),
}] : [];
---
<SiteLayout
  title={`${d.name}: the framework, step by step | Andy Whyte`}
  description={d.oneLiner}
  pageType="framework"
  schema={howTo}
  breadcrumbs={[{ name: 'Frameworks', href: '/frameworks/' }, { name: d.name, href: `/frameworks/${entry.id}/` }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-page-head__in">
      <p class="nb-eyebrow">Framework</p>
      <h1>{d.name}</h1>
      <p class="nb-lede">{d.oneLiner}</p>
      <p class="nb-meta">Use it when: {d.useWhen}</p>
    </div>
  </section>

  {d.steps.length > 0 && (
    <section class="nb-section nb-section--tint" style="padding-block:clamp(32px,5vw,56px)">
      <div class="nb-shell">
        <p class="nb-eyebrow" style="margin-bottom:16px">The steps</p>
        <ol class="steps">
          {d.steps.map((s: string) => <li>{s}</li>)}
        </ol>
      </div>
    </section>
  )}

  <section class="nb-section" style="padding-top:clamp(24px,3vw,48px)">
    <div class="nb-shell body">
      <div class="nb-prose"><Content /></div>
      <aside class="body__side">
        {hub && (
          <div class="side-card">
            <p class="nb-eyebrow">Part of</p>
            <a class="side-link" href={`/${hub.slug}/`}>{hub.title} &rarr;</a>
          </div>
        )}
        {maxims.length > 0 && (
          <div class="side-card">
            <p class="nb-eyebrow">In the notebook</p>
            {maxims.map((m) => <a class="side-link" href={m.href}>No. {pad2(m.n)}: {m.page.title} &rarr;</a>)}
          </div>
        )}
        <div class="side-card">
          <p class="nb-eyebrow">More</p>
          <a class="side-link" href="/frameworks/">All frameworks &rarr;</a>
          <a class="side-link" href="/glossary/">The glossary &rarr;</a>
        </div>
      </aside>
    </div>
  </section>

  {maxims.length > 0 && (
    <section class="nb-section nb-section--tint">
      <div class="nb-shell">
        <div class="nb-section-head">
          <p class="nb-eyebrow">From the notebook</p>
          <h2>The Maxims this comes from.</h2>
        </div>
        <div class="nb-grid nb-grid--3">
          {maxims.map((m) => (
            <a class="rel-card" href={m.href}>
              <div class="nb-page"><img src={m.page.src} alt={m.page.alt} loading="lazy" width="1600" height="1096" /></div>
              <p class="nb-meta">No. {pad2(m.n)} · {pillarLabel[m.page.pillar]}</p>
              <h3>{m.page.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</SiteLayout>

<style>
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: step; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; }
  .steps li { counter-increment: step; background: #fff; border: 1px solid var(--nb-line); border-radius: var(--radius-ui); padding: 20px 20px 20px 60px; position: relative; line-height: 1.5; }
  .steps li::before { content: counter(step); position: absolute; left: 18px; top: 18px; width: 28px; height: 28px; border-radius: 999px; background: var(--nb-cover); color: #fff; display: grid; place-items: center; font-size: 13px; font-weight: 700; }
  .body { display: grid; grid-template-columns: minmax(0, 66ch) 280px; gap: clamp(32px, 5vw, 80px); }
  .body__side { display: flex; flex-direction: column; gap: 20px; }
  .side-card { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1px solid var(--nb-line); border-radius: var(--radius-ui); background: #fff; }
  .side-link { font-weight: 600; text-decoration: none; font-size: 15px; }
  .side-link:hover { text-decoration: underline; }
  @media (max-width: 900px) { .body { grid-template-columns: minmax(0, 1fr); } }
  .rel-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; }
  .rel-card .nb-page img { object-fit: contain; background: var(--nb-paper); }
  .rel-card h3 { font-size: 18px; }
</style>
