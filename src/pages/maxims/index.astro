---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { library, pillarLabel, pillarInfo, pad2, pageFor } from '../../data/notebook-pages';
import { SITE } from '../../data/site';
import { entryHref, byNumber } from '../../lib/maxims';

const entries = (await getCollection('journal', (e) => !e.data.draft)).sort(byNumber);
const hrefFor = (n: number) => { const e = entries.find((x) => x.data.awj_number === n); return e ? entryHref(e) : undefined; };

const collection = {
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/maxims/#page`,
  url: `${SITE.url}/maxims/`,
  name: 'The AWJ Maxims',
  description: 'Every Maxim in the notebook: single-line principles for sales, founding and being human, each with the essay behind it.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: entries.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.data.title, url: `${SITE.url}${entryHref(e)}` })),
  },
};
---
<SiteLayout
  title="The AWJ Maxims: principles for sales, founding and being human"
  description="Every Maxim in Andy Whyte's notebook, in order. Single-line principles on sales, founding and being human, each with the essay behind it."
  pageType="maxims-list"
  schema={[collection]}
  breadcrumbs={[{ name: 'Maxims', href: '/maxims/' }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-page-head__in">
      <p class="nb-eyebrow">The library</p>
      <h1>Twenty Maxims. One line each. An essay behind every one.</h1>
      <p class="nb-lede">Written by hand in a blue notebook, photographed, and explained. Filter by pillar or read them in order.</p>
      <div class="filters" role="group" aria-label="Filter by pillar">
        <button type="button" class="nb-pill is-on" data-filter="all" aria-pressed="true">All</button>
        {(['sales', 'founder', 'human'] as const).map((p) => (
          <button type="button" class={`nb-pill nb-pill--${p}`} data-filter={p} aria-pressed="false">{pillarLabel[p]}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="nb-section" style="padding-top:0">
    <div class="nb-shell">
      <ol class="wall" data-wall>
        {library.map((m) => {
          const page = pageFor(m.number);
          const href = m.coming ? undefined : hrefFor(m.number);
          return (
            <li class={`wall__item ${m.coming ? 'wall__item--coming' : ''}`} data-pillar={m.pillar ?? 'coming'}>
              {href && page ? (
                <a href={href} class="wall__card">
                  <div class="nb-page"><img src={page.src} alt={page.alt} loading="lazy" width="1600" height="1096" /></div>
                  <p class="wall__meta nb-meta"><span>No. {pad2(m.number)}</span><span class={`nb-pill nb-pill--${m.pillar}`}>{pillarLabel[m.pillar!]}</span></p>
                  <h2 class="wall__title">{m.title}</h2>
                </a>
              ) : (
                <div class="wall__card wall__card--coming">
                  <div class="nb-page nb-page--blank"><span>No. {pad2(m.number)}</span></div>
                  <p class="wall__meta nb-meta"><span>No. {pad2(m.number)}</span><span class="nb-pill">Coming</span></p>
                  <h2 class="wall__title">{m.coming ? 'Being written' : m.title}</h2>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Three pillars</p>
        <h2>Every Maxim belongs to one of three.</h2>
      </div>
      <div class="nb-grid nb-grid--3">
        {(['sales', 'founder', 'human'] as const).map((p) => (
          <a class="nb-card pillar-card" href={`/pillars/${p}/`}>
            <span class={`nb-pill nb-pill--${p}`}>{pillarInfo[p].tag}</span>
            <h3>{pillarInfo[p].label}</h3>
            <p>{pillarInfo[p].description}</p>
            <span class="pillar-card__more">Read the {pillarInfo[p].label.toLowerCase()} Maxims &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  function wire() {
    const wall = document.querySelector<HTMLElement>('[data-wall]');
    if (!wall || wall.dataset.ready) return;
    wall.dataset.ready = '1';
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      wall.querySelectorAll<HTMLElement>('.wall__item').forEach((item) => { item.hidden = f !== 'all' && item.dataset.pillar !== f; });
    }));
  }
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
  .filters .nb-pill { cursor: pointer; font: inherit; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .filters .nb-pill.is-on { background: var(--nb-text); color: #fff; border-color: var(--nb-text); }
  .wall { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: clamp(20px, 3vw, 36px); }
  .wall__item[hidden] { display: none; }
  .wall__card { display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: inherit; }
  .wall__card .nb-page img { object-fit: contain; background: var(--nb-paper); }
  .wall__card .nb-page { transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out); }
  a.wall__card:hover .nb-page { transform: translateY(-4px) rotate(-.4deg); box-shadow: var(--shadow-lift); }
  .nb-page--blank { display: grid; place-items: center; color: var(--nb-text-3); font-weight: 600; letter-spacing: .04em; box-shadow: none; border: 1px dashed var(--nb-line); background: #fff; }
  .wall__meta { display: flex; align-items: center; gap: 10px; }
  .wall__title { font-size: clamp(17px, 1.4vw, 20px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .wall__item--coming .wall__title { color: var(--nb-text-3); font-style: italic; font-weight: 500; }
  .pillar-card { text-decoration: none; color: inherit; }
  .pillar-card .nb-pill { align-self: flex-start; }
  .pillar-card p { color: var(--nb-text-2); font-size: 15px; line-height: 1.5; flex: 1; }
  .pillar-card__more { font-weight: 600; font-size: 14px; color: var(--nb-ink); }
</style>
