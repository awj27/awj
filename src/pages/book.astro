---
import SiteLayout from '../layouts/SiteLayout.astro';
import FAQ from '../components/v2/FAQ.astro';
import { SITE } from '../data/site';

const AMAZON_UK = 'https://www.amazon.co.uk/MEDDICC-ultimate-guide-staying-complex/dp/1838239707';
const AMAZON_US = 'https://www.amazon.com/MEDDICC-ultimate-guide-staying-complex/dp/1838239707';

const faqs = [
  { q: 'What is the MEDDICC book about?', a: 'MEDDICC by Andy Whyte is the field-tested playbook for MEDDPICC, the common language for qualification, methodology and value selling used by the best-performing enterprise sales teams. It explains every letter of MEDDPICC, Metrics, Economic Buyer, Decision Criteria, Decision Process, Paper Process, Implicate the Pain, Champion and Competition, with the depth and case studies needed to apply it in real deals.' },
  { q: 'How many copies has the MEDDICC book sold?', a: `Over ${SITE.facts.copies} copies worldwide. It is the highest-rated MEDDIC and MEDDPICC book on Amazon, with a 4.7-star rating across more than 1,447 reviews, and more than ${SITE.facts.graduates} people have graduated from the MEDDICC Masterclass built on it.` },
  { q: 'Who is the foreword by?', a: 'The book includes a foreword and commentary from the co-creators of MEDDIC, Dick Dunkel and Jack Napoli, who originally developed MEDDIC at PTC.' },
  { q: 'Is the MEDDICC book good for beginners?', a: 'Yes. It is written for account executives running their first complex deal, sales leaders who want better forecast accuracy, and founders selling enterprise. The letters are explained one by one with examples, then layered with the patterns that separate A-players from theatre.' },
  { q: 'Is there a Kindle or audiobook version?', a: 'Yes. MEDDICC is available in paperback, Kindle and audiobook from Amazon globally.' },
  { q: 'What is the difference between MEDDIC, MEDDICC and MEDDPICC?', a: 'MEDDIC is the original six letters, created by Jack Napoli and Dick Dunkel at PTC: Metrics, Economic Buyer, Decision Criteria, Decision Process, Implicate the Pain and Champion. MEDDICC adds Competition. MEDDPICC adds the Paper Process, the procurement and legal steps that so often kill deals at the close. The book covers all three.' },
];

const reviews = [
  { body: 'This book would make a great introduction to the MEDDICC Sales process. For me personally it was a fantastic refresher and has prompted me to re-evaluate how I have used some elements of the process in previous roles. I highly recommend this book to any Sales Leader looking to drive greater predictability in their pipeline.', source: 'Amazon UK reader' },
  { body: "Andy articulated everything in it so well it's easily understandable. I've learnt so much reading it and I look forward to actioning lots of his teachings to improve my performance massively.", source: 'Amazon UK reader' },
  { body: 'Well thought out, and goes very much in depth in the MEDDIC process. I learned a lot from this book.', source: 'Amazon US reader' },
];

const stats = [
  { num: `${SITE.facts.copies}+`, label: 'Copies sold worldwide' },
  { num: '4.7', label: 'Amazon rating across 1,447+ reviews' },
  { num: `${SITE.facts.graduates}+`, label: 'Masterclass graduates' },
];

const book = {
  '@type': 'Book',
  '@id': `${SITE.url}/#book-meddicc`,
  name: 'MEDDICC: The ultimate guide to staying one step ahead in the complex sale',
  alternateName: 'MEDDICC',
  author: { '@id': `${SITE.url}/#andy` },
  isbn: '978-1838239701',
  bookFormat: 'https://schema.org/Paperback',
  inLanguage: 'en',
  url: `${SITE.url}/book/`,
  image: `${SITE.url}/media/book/meddicc-cover.jpg`,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.7', ratingCount: '1447', bestRating: '5', worstRating: '1' },
  offers: { '@type': 'Offer', url: AMAZON_UK, availability: 'https://schema.org/InStock' },
  about: ['MEDDICC', 'MEDDPICC', 'Sales Qualification', 'Value Selling', 'Enterprise Sales', 'Complex Sales'],
};
---
<SiteLayout
  title="MEDDICC by Andy Whyte: the best-selling book on the common language of sales"
  description="The ultimate guide to staying one step ahead in the complex sale. Over 100,000 copies sold, 4.7 stars across 1,447+ reviews. Paperback, Kindle and audiobook."
  pageType="book"
  ogImage="/media/book/meddicc-cover.jpg"
  schema={[book]}
  breadcrumbs={[{ name: 'Book', href: '/book/' }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-split">
      <div class="nb-page-head__in">
        <p class="nb-eyebrow">International best-seller</p>
        <h1>MEDDICC</h1>
        <p class="nb-lede">The ultimate guide to staying one step ahead in the complex sale.</p>
        <ul class="stats" aria-label="The numbers">
          {stats.map((s) => <li><span class="stats__num">{s.num}</span><span class="stats__lbl">{s.label}</span></li>)}
        </ul>
        <div class="nb-page-head__actions">
          <a class="btn btn--blue" href={AMAZON_UK} target="_blank" rel="noopener">Buy on Amazon UK</a>
          <a class="btn btn--ghost" href={AMAZON_US} target="_blank" rel="noopener">Buy on Amazon US</a>
        </div>
      </div>
      <div class="cover">
        <img src="/media/book/meddicc-cover.jpg" srcset="/media/book/meddicc-cover-mobile.jpg 800w, /media/book/meddicc-cover.jpg 1600w" sizes="(max-width: 820px) 80vw, 420px" alt="MEDDICC by Andy Whyte, the book" loading="eager" decoding="async" width="640" height="960" />
      </div>
    </div>
  </section>

  <section class="nb-section" style="padding-top:clamp(24px,3vw,48px)">
    <div class="nb-shell">
      <div class="nb-prose">
        <h2>What it is.</h2>
        <p>The first book to put MEDDICC down in writing, with a foreword and commentary from the co-creators of MEDDIC, <strong>Dick Dunkel</strong> and <strong>Jack Napoli</strong>.</p>
        <p>It is the field-tested playbook for MEDDPICC, the common language for qualification, methodology and value selling used by the best-performing enterprise sales teams. Built for sellers who refuse to lose deals to bad qualification, and for leaders who want a forecast they can stand behind.</p>
        <h2>Who it is for.</h2>
        <p>Account executives running complex deals. Sales leaders who want their team inspecting the deal rather than reciting it. Founders selling enterprise. Anyone who has ever heard a rep say "the deal is going great" and wanted a way to test that claim.</p>
        <h2>What you get.</h2>
        <p><strong>The letters.</strong> Every letter of MEDDPICC explained with a depth nothing else on the market matches. Metrics, Economic Buyer, Decision Criteria, Decision Process, Paper Process, Implicate the Pain, Champion, Competition.</p>
        <p><strong>The patterns.</strong> What A-players do that B-players miss. The deal-killers. The early signals that a forecast is fiction.</p>
        <p><strong>The plays.</strong> Real frameworks, the Champion Test, qualifying out, the deal-inspection rhythm, that you can run on Monday morning. The <a href="/frameworks/">frameworks</a> and the <a href="/glossary/">glossary</a> on this site are the companion.</p>
      </div>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">From the readers</p>
        <h2>4.7 stars across 1,447+ reviews.</h2>
      </div>
      <ul class="nb-grid nb-grid--3 reviews">
        {reviews.map((r) => (
          <li class="nb-card">
            <p class="review__stars" aria-label="5 out of 5 stars">★★★★★</p>
            <p class="review__body">"{r.body}"</p>
            <p class="nb-meta">{r.source}</p>
          </li>
        ))}
      </ul>
      <p class="nb-note" style="margin-top:22px"><a href={AMAZON_UK} target="_blank" rel="noopener">Read all the reviews on Amazon &rarr;</a></p>
    </div>
  </section>

  <FAQ items={faqs} tint={false} />

  <section class="nb-section nb-section--blue">
    <div class="nb-shell cta">
      <div class="nb-stack">
        <p class="nb-eyebrow">Get the book</p>
        <h2>Stop losing deals to bad qualification.</h2>
        <p class="nb-lede">Available in paperback, Kindle and audiobook. Ships globally.</p>
      </div>
      <div class="nb-page-head__actions">
        <a class="btn btn--yellow" href={AMAZON_UK} target="_blank" rel="noopener">Buy on Amazon UK</a>
        <a class="btn btn--ghost cta__ghost" href={AMAZON_US} target="_blank" rel="noopener">Buy on Amazon US</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .cover img { max-width: 420px; width: 100%; margin-inline: auto; border-radius: 6px; box-shadow: var(--shadow-lift); transform: rotate(-2deg); }
  .stats { margin: 6px 0 0; padding: 0; list-style: none; display: flex; gap: 28px; flex-wrap: wrap; }
  .stats li { display: flex; flex-direction: column; }
  .stats__num { font-size: clamp(26px, 2.6vw, 34px); font-weight: 600; letter-spacing: -0.02em; color: var(--nb-cover); }
  .stats__lbl { font-size: 13px; color: var(--nb-text-3); }
  .reviews { list-style: none; padding: 0; margin: 0; }
  .review__stars { color: var(--nb-yellow-deep); letter-spacing: .1em; font-size: 14px; }
  .review__body { flex: 1; font-size: 16px; line-height: 1.55; }
  .cta { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: center; }
  .cta__ghost { border-color: rgba(255,255,255,.4); color: #fff; background: transparent; }
  @media (max-width: 820px) { .cta { grid-template-columns: 1fr; } }
</style>
