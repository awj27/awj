---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import NotebookHero from '../components/v2/NotebookHero.astro';
import { notebookPages, library, pillarLabel, pad2 } from '../data/notebook-pages';
import { HUBS, SITE } from '../data/site';
import { entryHref, byNumber } from '../lib/maxims';

const entries = (await getCollection('journal', (e) => !e.data.draft)).sort(byNumber);
const hrefFor = (n: number) => { const e = entries.find((x) => x.data.awj_number === n); return e ? entryHref(e) : '/maxims/'; };
const heroPages = notebookPages.map((p) => ({ ...p, href: hrefFor(p.number) }));

const itemList = {
  '@type': 'ItemList',
  '@id': `${SITE.url}/#maxims`,
  name: 'The AWJ Maxims',
  numberOfItems: heroPages.length,
  itemListElement: heroPages.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: `${SITE.url}${p.href}` })),
};
---
<SiteLayout
  title="Andy Whyte Journal: principles for sales, founding and being human"
  description="A journal of handwritten Maxims from Andy Whyte, founder and CEO of MEDDICC, with topic hubs, frameworks and a glossary on MEDDPICC, sales leadership, keynote speaking and imposter syndrome."
  pageType="home"
  snap
  schema={[itemList]}
>
  <NotebookHero pages={heroPages} />

  <section class="nb-section" id="library">
    <div class="nb-shell">
      <div class="lib-head">
        <div class="nb-section-head" style="margin-bottom:0">
          <p class="nb-eyebrow">The library</p>
          <h2>Twenty Maxims. Eighteen written, two on the way.</h2>
        </div>
        <a class="btn btn--ghost" href="/start-here/">New here? Start here</a>
      </div>
      <ol class="lib">
        {library.map((m) => (
          <li class={`lib__row ${m.coming ? 'lib__row--coming' : ''}`}>
            {m.coming ? (
              <span>
                <span class="lib__num">No. {pad2(m.number)}</span>
                <span class="lib__title">{m.title}</span>
                <span class="nb-pill">Coming</span>
              </span>
            ) : (
              <a href={hrefFor(m.number)}>
                <span class="lib__num">No. {pad2(m.number)}</span>
                <span class="lib__title">{m.title}</span>
                <span class={`nb-pill nb-pill--${m.pillar}`}>{pillarLabel[m.pillar!]}</span>
              </a>
            )}
          </li>
        ))}
      </ol>
      <p class="nb-note" style="margin-top:18px"><a href="/maxims/">Browse by pillar, with the pages &rarr;</a></p>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Four things I am known for</p>
        <h2>Go deeper on the subjects behind the Maxims.</h2>
      </div>
      <div class="nb-grid nb-grid--4">
        {HUBS.map((h) => (
          <a class="nb-card hub-card" href={`/${h.slug}/`}>
            <h3>{h.title}</h3>
            <p>{h.line}</p>
            <span class="hub-card__more">Read the hub &rarr;</span>
          </a>
        ))}
      </div>
      <p class="nb-note" style="margin-top:22px">Also: <a href="/glossary/">the glossary</a>, every term defined plainly, and <a href="/frameworks/">the frameworks</a> behind the Maxims.</p>
    </div>
  </section>

  <section class="nb-section">
    <div class="nb-shell nb-split nb-split--photo-first">
      <div class="about__photo">
        <img src="/media/portrait/andy-portrait.jpg" alt="Andy Whyte" loading="lazy" width="800" height="1000" />
      </div>
      <div class="nb-stack">
        <p class="nb-eyebrow">About</p>
        <h2>Twenty years in sales. One book. One company. One journal.</h2>
        <p class="nb-lede">I am Andy Whyte, founder and CEO of MEDDICC and the author of the book that over {SITE.facts.copies} sellers have read. This journal is where the thinking gets written down before it gets tidied up.</p>
        <div class="nb-page-head__actions">
          <a class="btn btn--blue" href="/about/">The full story</a>
          <a class="btn btn--ghost" href="/speaking/">Book Andy to speak</a>
        </div>
      </div>
    </div>
  </section>

  <section class="nb-section nb-section--blue">
    <div class="nb-shell nb-split">
      <div class="nb-stack">
        <p class="nb-eyebrow">The book</p>
        <h2>MEDDICC. The number one best-selling book on the common language of sales.</h2>
        <p class="nb-lede">Over {SITE.facts.copies} copies sold and more than {SITE.facts.graduates} graduates of the Masterclass built on it. The common language for qualification, methodology and value selling, explained by someone who has run it in the room.</p>
        <div class="nb-page-head__actions">
          <a class="btn btn--white" href="/book/">About the book</a>
          <a class="btn btn--ghost book__ghost" href="/meddpicc/">What is MEDDPICC?</a>
        </div>
      </div>
      <div class="book__cover">
        <img src="/media/book/meddicc-cover.jpg" alt="The MEDDICC book cover" loading="lazy" width="640" height="960" />
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .lib-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 40px); }
  .lib { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--nb-line); }
  .lib__row > a, .lib__row > span { display: grid; grid-template-columns: 90px 1fr auto; gap: 20px; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--nb-line); text-decoration: none; color: var(--nb-text); transition: background .2s; }
  .lib__row > a:hover { background: var(--nb-canvas-2); }
  .lib__row--coming .lib__title { color: var(--nb-text-3); font-style: italic; }
  .lib__num { font-size: 13px; color: var(--nb-text-3); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .lib__title { font-size: clamp(17px, 1.5vw, 21px); font-weight: 500; letter-spacing: -0.01em; }
  @media (max-width: 560px) { .lib__row > a, .lib__row > span { grid-template-columns: 1fr; gap: 6px; } .lib__row .nb-pill { justify-self: start; } }
  .hub-card { text-decoration: none; color: inherit; }
  .hub-card p { color: var(--nb-text-2); font-size: 15px; line-height: 1.5; flex: 1; }
  .hub-card__more { font-weight: 600; font-size: 14px; color: var(--nb-ink); }
  .about__photo img { border-radius: var(--radius-ui); box-shadow: var(--shadow-page); aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  @media (max-width: 820px) { .about__photo { max-width: 360px; } }
  .book__cover img { max-width: 320px; margin-inline: auto; border-radius: 6px; box-shadow: 0 30px 70px rgba(10,16,50,.45); transform: rotate(-2deg); }
  .book__ghost { border-color: rgba(255,255,255,.4); color: #fff; background: transparent; }
  .book__ghost:hover { border-color: #fff; }
</style>
