---
import SiteLayout from '../layouts/SiteLayout.astro';
import SubscribeForm from '../components/v2/SubscribeForm.astro';
import { SITE } from '../data/site';
---
<SiteLayout
  title="Subscribe to the Andy Whyte Journal"
  description="New Maxims in your inbox, in full. Published on Substack when a page is written. No schedule promised, no spam."
  pageType="subscribe"
  breadcrumbs={[{ name: 'Subscribe', href: '/subscribe/' }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-split">
      <div class="nb-page-head__in">
        <p class="nb-eyebrow">The journal, in your inbox</p>
        <h1>When a page gets written, you get the Maxim.</h1>
        <p class="nb-lede">No schedule promised. No noise. One email when there is a new Maxim, with the line, the page and the thinking behind it.</p>
        <SubscribeForm source="subscribe-page" compact />
        <p class="nb-note">{SITE.substackUrl ? <>Published on <a href={SITE.substackUrl} target="_blank" rel="noopener">Substack</a>. </> : null}Unsubscribe with one click, any time.</p>
      </div>
      <div class="pad">
        <img src="/notebook/pad-open-01.webp" alt="The AWJ journal, open on page one" loading="eager" width="1400" height="1925" />
      </div>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">What you get</p>
        <h2>Three things, and nothing else.</h2>
      </div>
      <div class="nb-grid nb-grid--3">
        <div class="nb-card"><h3>The Maxim</h3><p class="card-body">One line, written by hand. The kind you end up repeating in a deal review.</p></div>
        <div class="nb-card"><h3>The Maxim in full</h3><p class="card-body">Observation, principle, model, application. Six hundred words, no filler.</p></div>
        <div class="nb-card"><h3>The occasional note</h3><p class="card-body">A talk, a book chapter, a framework. Only when it is worth your inbox.</p></div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .pad img { max-width: 360px; width: 100%; margin-inline: auto; border-radius: 6px; box-shadow: var(--shadow-lift); transform: rotate(-1.5deg); }
  .card-body { color: var(--nb-text-2); font-size: 15px; line-height: 1.5; }
</style>
