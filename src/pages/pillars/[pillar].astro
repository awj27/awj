---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pillarInfo, pillarLabel, pad2, pageFor, pageImage, type Pillar } from '../../data/notebook-pages';
import { SITE, HUBS } from '../../data/site';
import { entryHref, byNumber } from '../../lib/maxims';

export function getStaticPaths() {
  return (['sales', 'founder', 'human'] as Pillar[]).map((pillar) => ({ params: { pillar }, props: { pillar } }));
}

const { pillar } = Astro.props as { pillar: Pillar };
const info = pillarInfo[pillar];
const entries = (await getCollection('journal', (e) => !e.data.draft && e.data.pillar === pillar)).sort(byNumber);
const related = HUBS.filter((h) => info.hubs.includes(h.slug));

const titles: Record<Pillar, string> = {
  sales: 'Sales Maxims: MEDDICC, deal inspection and qualifying out',
  founder: 'Founder Maxims: building a company without the theatre',
  human: 'Human Maxims: authenticity, mental health and growth',
};
const descriptions: Record<Pillar, string> = {
  sales: 'The sales pillar of the Andy Whyte Journal: Maxims on qualification, MEDDICC, deal inspection and leading a sales team as a thinking discipline.',
  founder: 'The founder pillar of the Andy Whyte Journal: Maxims on hiring, feedback, failure and running a bootstrapped company.',
  human: 'The human pillar of the Andy Whyte Journal: Maxims on authenticity, imposter syndrome, mental health and growth.',
};

const collection = {
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/pillars/${pillar}/#page`,
  url: `${SITE.url}/pillars/${pillar}/`,
  name: titles[pillar],
  description: descriptions[pillar],
  mainEntity: { '@type': 'ItemList', itemListElement: entries.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.data.title, url: `${SITE.url}${entryHref(e)}` })) },
};
---
<SiteLayout
  title={`${titles[pillar]} | Andy Whyte Journal`}
  description={descriptions[pillar]}
  pageType="pillar"
  pillar={pillar}
  schema={[collection]}
  breadcrumbs={[{ name: 'Maxims', href: '/maxims/' }, { name: info.label, href: `/pillars/${pillar}/` }]}
>
  <section class="nb-page-head">
    <div class="nb-shell nb-page-head__in">
      <p class="nb-eyebrow">Pillar · {info.tag}</p>
      <h1>{info.label}</h1>
      <p class="nb-lede">{info.description}</p>
    </div>
  </section>

  <section class="nb-section" style="padding-top:0">
    <div class="nb-shell">
      <ol class="wall">
        {entries.map((e) => {
          const p = pageFor(e.data.awj_number);
          return (
            <li>
              <a href={entryHref(e)} class="wall__card">
                <div class="nb-page"><img src={p?.src ?? pageImage(e.data.awj_number)} alt={p?.alt ?? e.data.title} loading="lazy" width="1600" height="1096" /></div>
                <p class="nb-meta">No. {pad2(e.data.awj_number)}</p>
                <h2 class="wall__title">{e.data.title}</h2>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="nb-section nb-section--tint">
    <div class="nb-shell">
      <div class="nb-section-head">
        <p class="nb-eyebrow">Go deeper</p>
        <h2>The hubs behind the {info.label.toLowerCase()} Maxims.</h2>
      </div>
      <div class="nb-grid nb-grid--3">
        {related.map((h) => (
          <a class="nb-card hub-card" href={`/${h.slug}/`}>
            <h3>{h.title}</h3>
            <p>{h.line}</p>
            <span class="hub-card__more">Read the hub &rarr;</span>
          </a>
        ))}
        <a class="nb-card hub-card" href="/maxims/">
          <h3>All the Maxims</h3>
          <p>Every pillar, every page, in order.</p>
          <span class="hub-card__more">The library &rarr;</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .wall { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: clamp(20px, 3vw, 36px); }
  .wall__card { display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: inherit; }
  .wall__card .nb-page img { object-fit: contain; background: var(--nb-paper); }
  .wall__card .nb-page { transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out); }
  .wall__card:hover .nb-page { transform: translateY(-4px) rotate(-.4deg); box-shadow: var(--shadow-lift); }
  .wall__title { font-size: clamp(17px, 1.4vw, 20px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .hub-card { text-decoration: none; color: inherit; }
  .hub-card p { color: var(--nb-text-2); font-size: 15px; line-height: 1.5; flex: 1; }
  .hub-card__more { font-weight: 600; font-size: 14px; color: var(--nb-ink); }
</style>
